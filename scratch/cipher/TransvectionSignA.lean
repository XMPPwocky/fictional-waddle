import Mathlib

/-!
# Sign of a transvection on bit vectors

Setting: `V n = Fin n → ZMod 2`, a linear functional `φ : V n →ₗ[ZMod 2] ZMod 2`,
a vector `v` with `φ v = 0`, and the map `T x = x + (φ x) • v`.

## PROVED

* `transv φ v` is a `ZMod 2`-linear map `V n →ₗ[ZMod 2] V n` with
  `transv φ v x = x + φ x • v` (`transv_apply`).
* If `φ v = 0` then `transv φ v (transv φ v x) = x` (`transv_involutive`); hence it defines
  a permutation `transvPerm φ v hv : Equiv.Perm (V n)` with `transvPerm φ v hv ^ 2 = 1`
  (`transvPerm_sq`), and a linear equivalence `transvLinearEquiv φ v hv` whose underlying
  function is the same (`transvLinearEquiv_apply`).
* If `φ = 0` or `v = 0` then `transvPerm φ v hv = 1` (`transvPerm_eq_one`).
* If `φ ≠ 0` and `v ≠ 0`:
  - `T x = x ↔ φ x = 0` (`transv_fixed_iff`, needs only `v ≠ 0`), i.e. the fixed points
    are exactly `ker φ`;
  - `Fintype.card {x // φ x = 0} = 2 ^ (n - 1)` (`card_ker`, needs only `φ ≠ 0`);
  - the number of fixed points of `transvPerm` is `2 ^ (n - 1)` (`card_fixedPoints_transv`),
    and the number of moved points is `2 ^ (n - 1)` (`card_support_transv`);
  - the cycle type is `Multiset.replicate (2 ^ (n - 2)) 2`, i.e. exactly `2 ^ (n - 2)`
    transpositions (`cycleType_transv`).
* Main theorem `sign_transv`: for all `n ≥ 3`, all `φ`, all `v` with `φ v = 0`,
  `Equiv.Perm.sign (transvPerm φ v hv) = 1`.
* Exact classification `sign_transv_eq_neg_one_iff`: for every `n`, `φ`, `v` with `φ v = 0`,
  the sign is `-1` iff `n = 2 ∧ φ ≠ 0 ∧ v ≠ 0`. (For `n ≤ 1` there is no transvection with
  `φ ≠ 0`, `v ≠ 0`, `φ v = 0`: `no_nontrivial_transv_le_one`.)
* Explicit `n = 2` example `sign_example_two`: `φ = LinearMap.proj 0`, `v = Pi.single 1 1`,
  `φ v = 0`, sign `-1`. So the hypothesis `n ≥ 3` in `sign_transv` cannot be dropped.
* Satisfiability of hypotheses: `example_n3_hyps` gives an explicit `n = 3` instance with
  `φ ≠ 0`, `v ≠ 0`, `φ v = 0`; `example_two_hyps` does the same for `n = 2`.

## CITED/INTERPRETED (not proved here)

* `Equiv.Perm.sign_of_pow_two_eq_one` and `Equiv.Perm.card_fixedPoints`,
  `Equiv.Perm.cycleType_of_pow_prime_eq_one` are Mathlib lemmas used as stated.
* Reading: every transvection of `GF(2)^n` is an even permutation of the `2^n` points once
  `n ≥ 3`, so the image of `SL_n(2)` (generated by transvections) in `Sym(2^n)` lies in the
  alternating group; the generation statement itself is not proved here.
-/

open Equiv

namespace TransvectionSignA

/-- Bit vectors of length `n`. -/
abbrev V (n : ℕ) := Fin n → ZMod 2

variable {n : ℕ}

/-- The transvection `x ↦ x + φ x • v`, as a linear map. -/
def transv (φ : V n →ₗ[ZMod 2] ZMod 2) (v : V n) : V n →ₗ[ZMod 2] V n :=
  LinearMap.id + LinearMap.smulRight φ v

theorem transv_apply (φ : V n →ₗ[ZMod 2] ZMod 2) (v x : V n) :
    transv φ v x = x + φ x • v := rfl

lemma zmod2_add_self (a : ZMod 2) : a + a = 0 := by
  fin_cases a <;> decide

lemma V_add_self (x : V n) : x + x = 0 := by
  funext i; exact zmod2_add_self (x i)

lemma zmod2_ne_zero (a : ZMod 2) (h : a ≠ 0) : a = 1 := by
  fin_cases a
  · exact absurd rfl h
  · rfl

theorem transv_involutive (φ : V n →ₗ[ZMod 2] ZMod 2) (v : V n) (hv : φ v = 0) (x : V n) :
    transv φ v (transv φ v x) = x := by
  show (x + φ x • v) + φ (x + φ x • v) • v = x
  simp only [map_add, map_smul, hv, smul_eq_mul, mul_zero, add_zero]
  rw [add_assoc, ← add_smul, zmod2_add_self, zero_smul, add_zero]

/-- The transvection as a permutation of `V n`. -/
def transvPerm (φ : V n →ₗ[ZMod 2] ZMod 2) (v : V n) (hv : φ v = 0) : Perm (V n) where
  toFun := transv φ v
  invFun := transv φ v
  left_inv := transv_involutive φ v hv
  right_inv := transv_involutive φ v hv

theorem transvPerm_apply (φ : V n →ₗ[ZMod 2] ZMod 2) (v : V n) (hv : φ v = 0) (x : V n) :
    transvPerm φ v hv x = x + φ x • v := rfl

/-- The transvection as a linear equivalence. -/
def transvLinearEquiv (φ : V n →ₗ[ZMod 2] ZMod 2) (v : V n) (hv : φ v = 0) :
    V n ≃ₗ[ZMod 2] V n :=
  { transv φ v with
    invFun := transv φ v
    left_inv := transv_involutive φ v hv
    right_inv := transv_involutive φ v hv }

theorem transvLinearEquiv_apply (φ : V n →ₗ[ZMod 2] ZMod 2) (v : V n) (hv : φ v = 0)
    (x : V n) : transvLinearEquiv φ v hv x = transvPerm φ v hv x := rfl

theorem transvPerm_sq (φ : V n →ₗ[ZMod 2] ZMod 2) (v : V n) (hv : φ v = 0) :
    transvPerm φ v hv ^ 2 = 1 := by
  refine Equiv.ext fun x => ?_
  rw [pow_two, Perm.mul_apply, Perm.one_apply]
  exact transv_involutive φ v hv x

theorem transvPerm_eq_one (φ : V n →ₗ[ZMod 2] ZMod 2) (v : V n) (hv : φ v = 0)
    (h : φ = 0 ∨ v = 0) : transvPerm φ v hv = 1 := by
  ext x
  rw [transvPerm_apply]
  rcases h with h | h
  · simp [h]
  · simp [h]

theorem transv_fixed_iff (φ : V n →ₗ[ZMod 2] ZMod 2) (v : V n) (hv0 : v ≠ 0) (x : V n) :
    transv φ v x = x ↔ φ x = 0 := by
  rw [transv_apply]
  constructor
  · intro h
    have h' : φ x • v = 0 := by
      have := congrArg (fun y => y - x) h
      simpa using this
    rcases smul_eq_zero.mp h' with h1 | h1
    · exact h1
    · exact absurd h1 hv0
  · intro h; simp [h]

/-- The kernel of a nonzero functional on `V n` has `2 ^ (n - 1)` elements. -/
theorem card_ker (φ : V n →ₗ[ZMod 2] ZMod 2) (hφ : φ ≠ 0) :
    Fintype.card {x : V n // φ x = 0} = 2 ^ (n - 1) := by
  obtain ⟨u, hu⟩ : ∃ u, φ u ≠ 0 := by
    by_contra h
    exact hφ (LinearMap.ext fun x => by
      by_contra hx
      exact h ⟨x, hx⟩)
  have hu1 : φ u = 1 := zmod2_ne_zero _ hu
  have e : {x : V n // φ x = 0} ≃ {x : V n // ¬ φ x = 0} :=
    { toFun := fun x => ⟨x.1 + u, by rw [map_add, x.2, hu1]; decide⟩
      invFun := fun x => ⟨x.1 + u, by
        rw [map_add, zmod2_ne_zero _ x.2, hu1]; decide⟩
      left_inv := fun x => by
        apply Subtype.ext; simp [add_assoc, V_add_self]
      right_inv := fun x => by
        apply Subtype.ext; simp [add_assoc, V_add_self] }
  have h1 := Fintype.card_congr e
  rw [Fintype.card_subtype_compl] at h1
  have hle := Fintype.card_subtype_le (fun x : V n => φ x = 0)
  have hcard : Fintype.card (V n) = 2 ^ n := by simp
  rw [hcard] at h1 hle
  rcases n with _ | m
  · simp at h1 hle; omega
  · simp only [Nat.add_sub_cancel, pow_succ] at h1 hle ⊢
    omega

lemma card_fix_eq (φ : V n →ₗ[ZMod 2] ZMod 2) (v : V n) (hv : φ v = 0) (hv0 : v ≠ 0) :
    Fintype.card (Function.fixedPoints (transvPerm φ v hv)) =
      Fintype.card {x : V n // φ x = 0} :=
  Fintype.card_congr (Equiv.subtypeEquivRight (fun x => by
    rw [Function.mem_fixedPoints, Function.IsFixedPt]
    exact transv_fixed_iff φ v hv0 x))

theorem card_fixedPoints_transv (φ : V n →ₗ[ZMod 2] ZMod 2) (v : V n) (hv : φ v = 0)
    (hφ : φ ≠ 0) (hv0 : v ≠ 0) :
    Fintype.card (Function.fixedPoints (transvPerm φ v hv)) = 2 ^ (n - 1) := by
  rw [card_fix_eq φ v hv hv0, card_ker φ hφ]

theorem card_support_transv (φ : V n →ₗ[ZMod 2] ZMod 2) (v : V n) (hv : φ v = 0)
    (hφ : φ ≠ 0) (hv0 : v ≠ 0) :
    (transvPerm φ v hv).support.card = 2 ^ (n - 1) := by
  have h1 := Perm.card_fixedPoints (transvPerm φ v hv)
  rw [Perm.sum_cycleType, card_fixedPoints_transv φ v hv hφ hv0] at h1
  have hle : (transvPerm φ v hv).support.card ≤ Fintype.card (V n) :=
    Finset.card_le_univ _
  have hcard : Fintype.card (V n) = 2 ^ n := by simp
  rw [hcard] at h1 hle
  have hn : 1 ≤ n := by
    rcases n with _ | m
    · exfalso
      -- with n = 0 the space is a single point, so every functional is zero
      exact hφ (LinearMap.ext fun x => by
        rw [Subsingleton.elim x 0, map_zero]; rfl)
    · omega
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  simp only [Nat.add_sub_cancel, pow_succ] at h1 hle ⊢
  omega

theorem cycleType_transv (φ : V n →ₗ[ZMod 2] ZMod 2) (v : V n) (hv : φ v = 0)
    (hφ : φ ≠ 0) (hv0 : v ≠ 0) :
    (transvPerm φ v hv).cycleType = Multiset.replicate (2 ^ (n - 2)) 2 := by
  have hct := Perm.cycleType_of_pow_prime_eq_one (p := 2) (transvPerm_sq φ v hv)
  have hsum := Perm.sum_cycleType (transvPerm φ v hv)
  rw [card_support_transv φ v hv hφ hv0] at hsum
  rw [hct] at hsum ⊢
  rw [Multiset.sum_replicate, smul_eq_mul] at hsum
  congr 1
  have hc := hsum
  set c := (transvPerm φ v hv).cycleType.card
  rcases n with _ | _ | m
  · simp at hc
  · simp at hc
  · simp only [show m + 1 + 1 - 2 = m by omega,
      show m + 1 + 1 - 1 = m + 1 by omega, pow_succ] at hc ⊢
    omega

/-- No nontrivial transvection exists for `n ≤ 1`. -/
theorem no_nontrivial_transv_le_one (hn : n ≤ 1) (φ : V n →ₗ[ZMod 2] ZMod 2) (v : V n)
    (hv : φ v = 0) (hφ : φ ≠ 0) : v = 0 := by
  have hk := card_ker φ hφ
  have h1 : 2 ^ (n - 1) = 1 := by
    rw [show n - 1 = 0 by omega]; rfl
  rw [h1] at hk
  have := Fintype.card_le_one_iff.mp hk.le ⟨v, hv⟩ ⟨0, map_zero φ⟩
  exact congrArg Subtype.val this

lemma sign_transv_nontrivial (φ : V n →ₗ[ZMod 2] ZMod 2) (v : V n) (hv : φ v = 0)
    (hφ : φ ≠ 0) (hv0 : v ≠ 0) :
    Perm.sign (transvPerm φ v hv) = (-1) ^ (2 ^ (n - 2)) := by
  rw [Perm.sign_of_pow_two_eq_one (transvPerm_sq φ v hv),
    card_fixedPoints_transv φ v hv hφ hv0]
  have hcard : Fintype.card (V n) = 2 ^ n := by simp
  rw [hcard]
  congr 1
  rcases n with _ | _ | m
  · exact absurd (no_nontrivial_transv_le_one (by omega) φ v hv hφ) hv0
  · exact absurd (no_nontrivial_transv_le_one (by omega) φ v hv hφ) hv0
  · simp only [show m + 1 + 1 - 2 = m by omega, show m + 1 + 1 - 1 = m + 1 by omega,
      pow_succ]
    omega

/-- Main theorem: for `n ≥ 3` every transvection of `(ZMod 2)^n` is an even permutation. -/
theorem sign_transv (hn : 3 ≤ n) (φ : V n →ₗ[ZMod 2] ZMod 2) (v : V n) (hv : φ v = 0) :
    Perm.sign (transvPerm φ v hv) = 1 := by
  by_cases h : φ = 0 ∨ v = 0
  · rw [transvPerm_eq_one φ v hv h, map_one]
  · rw [not_or] at h
    rw [sign_transv_nontrivial φ v hv h.1 h.2]
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 3 := ⟨n - 3, by omega⟩
    rw [show m + 3 - 2 = m + 1 by omega, pow_succ, pow_mul]
    simp

/-- Exact classification of when the sign is `-1`. -/
theorem sign_transv_eq_neg_one_iff (φ : V n →ₗ[ZMod 2] ZMod 2) (v : V n) (hv : φ v = 0) :
    Perm.sign (transvPerm φ v hv) = -1 ↔ (n = 2 ∧ φ ≠ 0 ∧ v ≠ 0) := by
  by_cases h : φ = 0 ∨ v = 0
  · rw [transvPerm_eq_one φ v hv h, map_one]
    constructor
    · intro h'; exact absurd h' (by decide)
    · rintro ⟨-, h1, h2⟩; rcases h with h | h <;> contradiction
  · rw [not_or] at h
    rw [sign_transv_nontrivial φ v hv h.1 h.2]
    constructor
    · intro hs
      refine ⟨?_, h.1, h.2⟩
      by_contra hn2
      rcases Nat.lt_or_ge n 2 with hlt | hge
      · exact h.2 (no_nontrivial_transv_le_one (by omega) φ v hv h.1)
      · have h3 : 3 ≤ n := by omega
        obtain ⟨m, rfl⟩ : ∃ m, n = m + 3 := ⟨n - 3, by omega⟩
        rw [show m + 3 - 2 = m + 1 by omega, pow_succ, pow_mul] at hs
        simp at hs
    · rintro ⟨rfl, -, -⟩
      rfl

/-! ### Explicit instances -/

/-- `n = 2`: `φ = x ↦ x 0`, `v = e₁`. -/
def phi2 : V 2 →ₗ[ZMod 2] ZMod 2 := LinearMap.proj 0
def v2 : V 2 := Pi.single 1 1

theorem example_two_hyps : phi2 v2 = 0 ∧ phi2 ≠ 0 ∧ v2 ≠ 0 := by
  refine ⟨by decide, ?_, ?_⟩
  · intro h
    have := LinearMap.congr_fun h (Pi.single 0 1)
    exact absurd this (by decide)
  · intro h
    have := congrFun h 1
    exact absurd this (by decide)

/-- The `n = 2` transvection `x ↦ x + x₀ • e₁` is an odd permutation. -/
theorem sign_example_two :
    Perm.sign (transvPerm phi2 v2 example_two_hyps.1) = -1 :=
  (sign_transv_eq_neg_one_iff phi2 v2 example_two_hyps.1).mpr
    ⟨rfl, example_two_hyps.2.1, example_two_hyps.2.2⟩

/-- `n = 3`: `φ = x ↦ x 0`, `v = e₁`; nontrivial, so `sign_transv` is not vacuous. -/
def phi3 : V 3 →ₗ[ZMod 2] ZMod 2 := LinearMap.proj 0
def v3 : V 3 := Pi.single 1 1

theorem example_n3_hyps : phi3 v3 = 0 ∧ phi3 ≠ 0 ∧ v3 ≠ 0 := by
  refine ⟨by decide, ?_, ?_⟩
  · intro h
    have := LinearMap.congr_fun h (Pi.single 0 1)
    exact absurd this (by decide)
  · intro h
    have := congrFun h 1
    exact absurd this (by decide)

theorem sign_example_three :
    Perm.sign (transvPerm phi3 v3 example_n3_hyps.1) = 1 :=
  sign_transv le_rfl phi3 v3 example_n3_hyps.1

theorem cycleType_example_three :
    (transvPerm phi3 v3 example_n3_hyps.1).cycleType = Multiset.replicate 2 2 :=
  cycleType_transv phi3 v3 _ example_n3_hyps.2.1 example_n3_hyps.2.2

end TransvectionSignA

