import Mathlib

/-!
# An AES-shaped substitution-permutation cipher is an even permutation of its block space

Notation: `V n = Fin n → ZMod 2` (the block space of `n` bits). For `n = c * k` the block is
viewed as `c` chunks of `k` bits through the explicit equivalence
`chunkEquiv c k : V (c * k) ≃ (Fin c → Fin k → ZMod 2)`, built from `finProdFinEquiv` and
`Equiv.curry` (bit `finProdFinEquiv (i, j)` of the block is bit `j` of chunk `i`).

A round `r : Round c k` consists of a key `r.key : V (c * k)`, S-boxes
`r.S : Fin c → Perm (Fin k → ZMod 2)` (arbitrary permutations of `k`-bit words) and an
invertible linear map `r.L : V (c * k) ≃ₗ[ZMod 2] V (c * k)` (arbitrary). Its permutation
`r.toPerm` sends `x` to `r.L (sboxLayer r.S (x + r.key))` (`Round.toPerm_apply`), where
`sboxLayer S` is `Equiv.piCongrRight S` transported to `V (c * k)` along `chunkEquiv`
(`sboxLayer_apply`). `cipher rs` applies the rounds of the list `rs` in order, head first
(`cipher_nil`, `cipher_cons_apply`).

## PROVED

* `sign_addRight`: for `2 ≤ n` and every `key : V n`, `sign (Equiv.addRight key) = 1`.
* `sign_sboxLayer`: for `1 ≤ k`, `2 ≤ c` and every `S : Fin c → Perm (Fin k → ZMod 2)`,
  `sign (sboxLayer S) = 1`.
* `sign_linearEquiv_eq_one`: for `n ≠ 2` and every `A : V n ≃ₗ[ZMod 2] V n`,
  `sign A.toEquiv = 1`; `sign_linearEquiv_eq_one_of_three_le` is the same under `3 ≤ n`.
* `sign_round` (single round): for `2 ≤ c`, `1 ≤ k`, `3 ≤ c * k` and every round `r`,
  `sign r.toPerm = 1`; `round_mem_alternatingGroup`: `r.toPerm ∈ alternatingGroup (V (c * k))`.
* `sign_cipher` (main result): under the same hypotheses, for every list `rs` of rounds
  (any keys, any S-boxes, any invertible linear maps), `sign (cipher rs) = 1`;
  `cipher_mem_alternatingGroup`: `cipher rs ∈ alternatingGroup (V (c * k))`.
* `closure_rounds_le_alternatingGroup`: under the same hypotheses, the subgroup of
  `Perm (V (c * k))` generated by all round permutations is contained in
  `alternatingGroup (V (c * k))`.
* `exists_odd_round_two_one`: the hypothesis `3 ≤ c * k` is not removable in `sign_round`:
  for `c = 2`, `k = 1` (so `c * k = 2`) there is a round `r : Round 2 1` with
  `sign r.toPerm ≠ 1`.
* Hypothesis instances: `instance_hyps` (`c = 2`, `k = 2`: `2 ≤ 2`, `1 ≤ 2`, `3 ≤ 2 * 2`),
  `instance_cipher` (an explicit two-round cipher on `V (2 * 2)` with nonzero key, odd S-boxes
  and identity linear map, of sign `1`), `instance_sbox_odd` (the S-box used there has sign
  `-1` on its own), `instance_addRight` (`n = 2`), `sign_transvection_three` and `example`s
  for the linear-layer lemmas at `n = 3`, `bits_layer_instance` for `bits_layer_even`.
* Supporting lemmas: `units_pow_even`, `sign_prodCongr`, `layer_conj`, `sign_layer`
  (`sign (piCongrRight S) = ∏ i, sign (S i) ^ (card α ^ (c - 1))`), `layer_even_of_even_card`,
  `card_bits`, `bits_layer_even`, `transvection_mulVec`, `card_coord_zero`,
  `sign_transvectionPerm`, `sign_of_eq_prod`, `sign_toPermHom`, `toEquiv_eq_toPermHom`,
  `swap2_toEquiv`, `sign_swap2`, `all_linear_even_iff` (`(∀ A, sign A.toEquiv = 1) ↔ n ≠ 2`).

Sources (copied, not imported, and renamed into this namespace): the S-box layer lemmas
(`units_pow_even`, `sign_prodCongr`, `layer_conj`, `sign_layer`, `layer_even_of_even_card`,
`card_bits`, `bits_layer_even`) are from `TensorSignA.lean`; the linear-layer lemmas
(`toPerm`, `toPermHom`, `transvection_mulVec`, `tUnit`, `card_coord_zero`,
`sign_transvectionPerm`, `sign_of_eq_prod`, `sign_toPermHom`, `unitOfLinearEquiv`,
`sign_linearEquiv_eq_one`, `swap2`, `all_linear_even_iff`) are from `LinearLayerSignB.lean`;
the `ZMod 2` helper lemmas `z2_add_self`, `z2_eq_one_of_ne_zero`, `bv_add_self` follow
`TransvectionSignB.lean`. The key-addition lemma `sign_addRight` and everything about chunks,
rounds and ciphers is new here.

## CITED / INTERPRETED (not proved here)

* Wernsdorf, "The one-round functions of the DES generate the alternating group" (1993), and
  Wernsdorf, "The round functions of RIJNDAEL generate the alternating group" (FSE 2002): the
  round functions generate all of `A_{2^64}` and `A_{2^128}` respectively. Only the inclusion
  into the alternating group is proved here; generation (equality) is not.
* Mathlib's `Matrix.Pivot.exists_list_transvec_mul_diagonal_mul_list_transvec`
  (transvection-diagonal-transvection decomposition) is used, not re-proved.
* Reading: AES itself fits this model with `c = 16`, `k = 8`, `n = 128`: AddRoundKey is
  `Equiv.addRight`, SubBytes is an S-box layer, and ShiftRows followed by MixColumns is a
  `GF(2)`-linear bijection of `V 128` (the last AES round omits MixColumns; ShiftRows alone is
  still linear and bijective, so it is covered). The byte ordering and the identification of
  AES's state with `V 128` are not formalised; the model allows any S-boxes and linear maps.
-/

namespace SPNCipherEven

open Equiv Equiv.Perm Matrix

/-! ## Arithmetic of `ℤˣ` and `ZMod 2` -/

/-- An even power of a unit of `ℤ` is `1`. -/
theorem units_pow_even {u : ℤˣ} {n : ℕ} (h : Even n) : u ^ n = 1 := by
  obtain ⟨k, rfl⟩ := h
  rw [← two_mul, pow_mul, Int.units_sq, one_pow]

theorem z2_add_self (a : ZMod 2) : a + a = 0 := by fin_cases a <;> rfl

theorem z2_cases (a : ZMod 2) : a = 0 ∨ a = 1 := by
  fin_cases a
  · exact Or.inl rfl
  · exact Or.inr rfl

theorem z2_eq_one_of_ne_zero (a : ZMod 2) (h : a ≠ 0) : a = 1 := by
  fin_cases a
  · exact absurd rfl h
  · rfl

/-- Bit vectors of length `n`. -/
abbrev V (n : ℕ) := Fin n → ZMod 2

theorem bv_add_self {n : ℕ} (w : V n) : w + w = 0 :=
  funext fun i => z2_add_self (w i)

theorem card_V (n : ℕ) : Fintype.card (V n) = 2 ^ n := by
  rw [Fintype.card_fun, ZMod.card, Fintype.card_fin]

/-! ## Key addition -/

/-- XOR with a fixed key is an even permutation of `V n` for `n ≥ 2`. -/
theorem sign_addRight {n : ℕ} (hn : 2 ≤ n) (key : V n) :
    sign (Equiv.addRight key : Perm (V n)) = 1 := by
  by_cases hk : key = 0
  · subst hk
    have : (Equiv.addRight (0 : V n) : Perm (V n)) = 1 := by
      ext x i; simp
    rw [this, map_one]
  · have hsq : (Equiv.addRight key : Perm (V n)) ^ 2 = 1 := by
      ext x i
      simp [pow_two, add_assoc, z2_add_self]
    have hfix : Fintype.card (Function.fixedPoints (Equiv.addRight key : Perm (V n))) = 0 := by
      rw [Fintype.card_eq_zero_iff]
      refine ⟨fun ⟨x, hx⟩ => hk ?_⟩
      have hx' : x + key = x := hx
      have := congrArg (fun y => y - x) hx'
      simpa using this
    rw [sign_of_pow_two_eq_one hsq, hfix, card_V, Nat.sub_zero]
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 2 := ⟨n - 2, by omega⟩
    have h : 2 ^ (m + 2) / 2 = 2 * 2 ^ m := by
      rw [pow_succ, Nat.mul_div_cancel _ (by norm_num), pow_succ, mul_comm]
    rw [h, pow_mul]
    simp

/-! ## S-box layers (copied from `TensorSignA.lean`) -/

section Layer

variable {α β : Type*} [DecidableEq α] [Fintype α] [DecidableEq β] [Fintype β]

/-- Sign of a product permutation. -/
theorem sign_prodCongr (σ : Perm α) (τ : Perm β) :
    sign (Equiv.prodCongr σ τ) = sign σ ^ Fintype.card β * sign τ ^ Fintype.card α := by
  have h : (Equiv.prodCongr σ τ : Perm (α × β)) =
      (Equiv.prodCongr σ (Equiv.refl β) : Perm (α × β)) *
        (Equiv.prodCongr (Equiv.refl α) τ : Perm (α × β)) := by
    ext ⟨a, b⟩ <;> rfl
  rw [h, Perm.sign_mul, prodCongr_refl_right, prodCongr_refl_left, sign_prodCongrLeft,
    sign_prodCongrRight, Finset.prod_const, Finset.prod_const, Finset.card_univ,
    Finset.card_univ]

omit [DecidableEq α] [Fintype α] in
/-- Splitting off the first chunk turns the layer into a product permutation. -/
theorem layer_conj {n : ℕ} (S : Fin (n + 1) → Perm α) :
    ((Fin.consEquiv (fun _ : Fin (n + 1) => α)).symm.permCongr (Equiv.piCongrRight S) :
        Perm (α × (Fin n → α))) =
      Equiv.prodCongr (S 0) (Equiv.piCongrRight fun i : Fin n => S i.succ) := by
  ext ⟨a, v⟩
  · simp [Equiv.permCongr_apply, Fin.consEquiv]
  · simp [Equiv.permCongr_apply, Fin.consEquiv, Fin.tail]

/-- Sign of a parallel S-box layer with `c` chunks. -/
theorem sign_layer (c : ℕ) (S : Fin c → Perm α) :
    sign (Equiv.piCongrRight S : Perm (Fin c → α)) =
      ∏ i, sign (S i) ^ (Fintype.card α ^ (c - 1)) := by
  induction c with
  | zero =>
    have : (Equiv.piCongrRight S : Perm (Fin 0 → α)) = 1 := Subsingleton.elim _ _
    simp [this]
  | succ n ih =>
    rw [← sign_permCongr (Fin.consEquiv (fun _ : Fin (n + 1) => α)).symm, layer_conj,
      sign_prodCongr, ih, Fin.prod_univ_succ, Fintype.card_fun, Fintype.card_fin,
      Nat.add_sub_cancel]
    congr 1
    rw [← Finset.prod_pow]
    refine Finset.prod_congr rfl fun i _ => ?_
    rcases n with _ | m
    · exact Fin.elim0 i
    · rw [← pow_mul, Nat.add_sub_cancel, ← pow_succ]

theorem layer_even_of_even_card {c : ℕ} (hα : Even (Fintype.card α)) (hc : 2 ≤ c)
    (S : Fin c → Perm α) :
    sign (Equiv.piCongrRight S : Perm (Fin c → α)) = 1 := by
  rw [sign_layer]
  have he : Even (Fintype.card α ^ (c - 1)) := (Nat.even_pow' (by omega)).2 hα
  exact Finset.prod_eq_one fun i _ => units_pow_even he

end Layer

theorem card_bits (k : ℕ) : Fintype.card (Fin k → ZMod 2) = 2 ^ k := card_V k

/-- On `k ≥ 1` bit chunks, a layer of `c ≥ 2` arbitrary S-boxes is even. -/
theorem bits_layer_even {k c : ℕ} (hk : 1 ≤ k) (hc : 2 ≤ c)
    (S : Fin c → Perm (Fin k → ZMod 2)) :
    sign (Equiv.piCongrRight S : Perm (Fin c → Fin k → ZMod 2)) = 1 := by
  refine layer_even_of_even_card ?_ hc S
  rw [card_bits]
  exact (Nat.even_pow' (by omega)).2 even_two

/-- Instance of the hypotheses of `bits_layer_even`: `k = 1`, `c = 2`, odd S-boxes. -/
theorem bits_layer_instance :
    1 ≤ 1 ∧ 2 ≤ 2 ∧ sign (swap (0 : Fin 1 → ZMod 2) 1) = -1 ∧
      sign (Equiv.piCongrRight (fun _ : Fin 2 => swap (0 : Fin 1 → ZMod 2) 1) :
        Perm (Fin 2 → Fin 1 → ZMod 2)) = 1 :=
  ⟨le_rfl, le_rfl, sign_swap (by decide), bits_layer_even le_rfl le_rfl _⟩

/-! ## Chunks and the S-box layer on the block space -/

/-- The block `V (c * k)` as `c` chunks of `k` bits: bit `finProdFinEquiv (i, j)` of the
block is bit `j` of chunk `i`. -/
def chunkEquiv (c k : ℕ) : V (c * k) ≃ (Fin c → Fin k → ZMod 2) :=
  (Equiv.arrowCongr finProdFinEquiv (Equiv.refl (ZMod 2))).symm.trans
    (Equiv.curry (Fin c) (Fin k) (ZMod 2))

theorem chunkEquiv_apply (c k : ℕ) (x : V (c * k)) (i : Fin c) (j : Fin k) :
    chunkEquiv c k x i j = x (finProdFinEquiv (i, j)) := rfl

/-- The S-box layer on the block space: apply `S i` to chunk `i`. -/
def sboxLayer {c k : ℕ} (S : Fin c → Perm (Fin k → ZMod 2)) : Perm (V (c * k)) :=
  (chunkEquiv c k).symm.permCongr (Equiv.piCongrRight S)

theorem sboxLayer_apply {c k : ℕ} (S : Fin c → Perm (Fin k → ZMod 2)) (x : V (c * k)) :
    sboxLayer S x = (chunkEquiv c k).symm (fun i => S i (chunkEquiv c k x i)) := rfl

theorem chunkEquiv_sboxLayer {c k : ℕ} (S : Fin c → Perm (Fin k → ZMod 2)) (x : V (c * k))
    (i : Fin c) : chunkEquiv c k (sboxLayer S x) i = S i (chunkEquiv c k x i) := by
  rw [sboxLayer_apply, Equiv.apply_symm_apply]

/-- An S-box layer of `c ≥ 2` arbitrary S-boxes on `k ≥ 1` bit chunks is even. -/
theorem sign_sboxLayer {c k : ℕ} (hk : 1 ≤ k) (hc : 2 ≤ c)
    (S : Fin c → Perm (Fin k → ZMod 2)) : sign (sboxLayer S) = 1 := by
  rw [sboxLayer, sign_permCongr]
  exact bits_layer_even hk hc S

/-! ## Linear layers (copied from `LinearLayerSignB.lean`) -/

/-- The permutation of `V n` induced by an invertible matrix acting by `mulVec`. -/
def toPerm {n : ℕ} (U : (Matrix (Fin n) (Fin n) (ZMod 2))ˣ) : Perm (V n) where
  toFun x := (U : Matrix (Fin n) (Fin n) (ZMod 2)) *ᵥ x
  invFun x := ((U⁻¹ : (Matrix (Fin n) (Fin n) (ZMod 2))ˣ) : Matrix (Fin n) (Fin n) (ZMod 2)) *ᵥ x
  left_inv x := by simp [Matrix.mulVec_mulVec]
  right_inv x := by simp [Matrix.mulVec_mulVec]

/-- `toPerm` as a group homomorphism. -/
def toPermHom (n : ℕ) : (Matrix (Fin n) (Fin n) (ZMod 2))ˣ →* Perm (V n) where
  toFun := toPerm
  map_one' := by ext x i; simp [toPerm]
  map_mul' U W := by ext x i; simp [toPerm, Matrix.mulVec_mulVec]

theorem toPermHom_apply {n : ℕ} (U : (Matrix (Fin n) (Fin n) (ZMod 2))ˣ) (x : V n) :
    toPermHom n U x = (U : Matrix (Fin n) (Fin n) (ZMod 2)) *ᵥ x := rfl

theorem transvection_mulVec {n : ℕ} (i j : Fin n) (c : ZMod 2) (x : V n) :
    transvection i j c *ᵥ x = x + Function.update (0 : V n) i (c * x j) := by
  simp [transvection, Matrix.add_mulVec, Matrix.single_mulVec]

/-- The unit of the matrix ring given by a transvection. -/
def tUnit {n : ℕ} (t : TransvectionStruct (Fin n) (ZMod 2)) :
    (Matrix (Fin n) (Fin n) (ZMod 2))ˣ :=
  ⟨t.toMatrix, t.inv.toMatrix, t.mul_inv, t.inv_mul⟩

/-- Number of bit vectors with a given coordinate equal to zero. -/
theorem card_coord_zero {n : ℕ} (j : Fin n) :
    2 * Fintype.card {x : V n // x j = 0} = 2 ^ n := by
  have hbij : Fintype.card {x : V n // x j = 0} = Fintype.card {x : V n // ¬ x j = 0} := by
    apply Fintype.card_congr
    refine
      { toFun := fun x => ⟨x.1 + Function.update (0 : V n) j 1, by simp [x.2]⟩
        invFun := fun x => ⟨x.1 + Function.update (0 : V n) j 1, by
          have := z2_eq_one_of_ne_zero _ x.2
          simp [this, z2_add_self]⟩
        left_inv := fun x => by
          ext i
          simp [add_assoc, z2_add_self]
        right_inv := fun x => by
          ext i
          simp [add_assoc, z2_add_self] }
  have hc := Fintype.card_subtype_compl (fun x : V n => x j = 0)
  have hle := Fintype.card_subtype_le (fun x : V n => x j = 0)
  have hV : Fintype.card (V n) = 2 ^ n := by simp
  omega

theorem sign_transvectionPerm {n : ℕ} (hn : n ≠ 2) (t : TransvectionStruct (Fin n) (ZMod 2)) :
    Perm.sign (toPermHom n (tUnit t)) = 1 := by
  obtain ⟨i, j, hij, c⟩ := t
  have hn3 : 3 ≤ n := by
    have h1 := i.2; have h2 := j.2
    have : (i : ℕ) ≠ j := fun h => hij (Fin.ext h)
    omega
  set σ := toPermHom n (tUnit ⟨i, j, hij, c⟩) with hσdef
  have hσ : ∀ x, σ x = x + Function.update (0 : V n) i (c * x j) := by
    intro x
    rw [hσdef, toPermHom_apply]
    exact transvection_mulVec i j c x
  rcases z2_cases c with rfl | rfl
  · have : σ = 1 := by
      ext x k
      simp [hσ]
    rw [this, map_one]
  · have hsq : σ ^ 2 = 1 := by
      ext x k
      rw [pow_two, Perm.mul_apply, hσ, hσ]
      have hj : (x + Function.update (0 : V n) i ((1 : ZMod 2) * x j)) j = x j := by
        simp [Function.update_of_ne (Ne.symm hij)]
      rw [hj]
      simp only [Pi.add_apply, add_assoc, z2_add_self, add_zero, Perm.one_apply]
    have hfix : Fintype.card (Function.fixedPoints σ) = Fintype.card {x : V n // x j = 0} := by
      apply Fintype.card_congr
      apply Equiv.subtypeEquivRight
      intro x
      rw [Function.mem_fixedPoints, Function.IsFixedPt, hσ]
      constructor
      · intro h
        have := congrFun h i
        simpa using this
      · intro h
        simp [h]
    rw [Perm.sign_of_pow_two_eq_one hsq, hfix]
    have hc := card_coord_zero j
    have hV : Fintype.card (V n) = 2 ^ n := by simp
    rw [hV]
    obtain ⟨m, rfl⟩ : ∃ m, n = m + 3 := ⟨n - 3, by omega⟩
    have h8 : 2 ^ (m + 3) = 8 * 2 ^ m := by ring
    rw [h8] at hc ⊢
    have : (8 * 2 ^ m - Fintype.card {x : V (m + 3) // x j = 0}) / 2 = 2 * 2 ^ m := by omega
    rw [this, pow_mul]
    simp

theorem sign_of_eq_prod {n : ℕ} (hn : n ≠ 2) (L : List (TransvectionStruct (Fin n) (ZMod 2))) :
    ∀ U : (Matrix (Fin n) (Fin n) (ZMod 2))ˣ,
      (U : Matrix (Fin n) (Fin n) (ZMod 2)) = (L.map TransvectionStruct.toMatrix).prod →
      Perm.sign (toPermHom n U) = 1 := by
  induction L with
  | nil =>
    intro U hU
    have : U = 1 := Units.ext (by simpa using hU)
    simp [this]
  | cons t L ih =>
    intro U hU
    have hU' : (((tUnit t)⁻¹ * U : (Matrix (Fin n) (Fin n) (ZMod 2))ˣ) :
        Matrix (Fin n) (Fin n) (ZMod 2)) = (L.map TransvectionStruct.toMatrix).prod := by
      rw [Units.val_mul, hU, List.map_cons, List.prod_cons, ← Matrix.mul_assoc]
      change t.inv.toMatrix * t.toMatrix * _ = _
      rw [t.inv_mul, Matrix.one_mul]
    have hsplit : U = tUnit t * ((tUnit t)⁻¹ * U) := by group
    rw [hsplit, map_mul, Perm.sign_mul, sign_transvectionPerm hn, ih _ hU', one_mul]

/-- Every invertible matrix over `ZMod 2` of size `n ≠ 2` induces an even permutation. -/
theorem sign_toPermHom {n : ℕ} (hn : n ≠ 2) (U : (Matrix (Fin n) (Fin n) (ZMod 2))ˣ) :
    Perm.sign (toPermHom n U) = 1 := by
  obtain ⟨L, L', D, hM⟩ :=
    Matrix.Pivot.exists_list_transvec_mul_diagonal_mul_list_transvec
      (U : Matrix (Fin n) (Fin n) (ZMod 2))
  have hdet : (U : Matrix (Fin n) (Fin n) (ZMod 2)).det ≠ 0 :=
    ((Matrix.isUnit_iff_isUnit_det _).mp U.isUnit).ne_zero
  rw [hM, Matrix.det_mul, Matrix.det_mul, TransvectionStruct.det_toMatrix_prod,
    TransvectionStruct.det_toMatrix_prod, Matrix.det_diagonal, one_mul, mul_one] at hdet
  have hD : D = fun _ => 1 := by
    funext k
    exact z2_eq_one_of_ne_zero _ (Finset.prod_ne_zero_iff.mp hdet k (Finset.mem_univ k))
  have hprod : (U : Matrix (Fin n) (Fin n) (ZMod 2)) =
      ((L ++ L').map TransvectionStruct.toMatrix).prod := by
    rw [hM, hD, Matrix.diagonal_one, Matrix.mul_one, List.map_append, List.prod_append]
  exact sign_of_eq_prod hn _ U hprod

/-- The unit of the matrix ring given by a linear automorphism. -/
def unitOfLinearEquiv {n : ℕ} (A : V n ≃ₗ[ZMod 2] V n) :
    (Matrix (Fin n) (Fin n) (ZMod 2))ˣ where
  val := LinearMap.toMatrix' (A : V n →ₗ[ZMod 2] V n)
  inv := LinearMap.toMatrix' (A.symm : V n →ₗ[ZMod 2] V n)
  val_inv := by rw [← LinearMap.toMatrix'_comp]; simp
  inv_val := by rw [← LinearMap.toMatrix'_comp]; simp

theorem toEquiv_eq_toPermHom {n : ℕ} (A : V n ≃ₗ[ZMod 2] V n) :
    A.toEquiv = toPermHom n (unitOfLinearEquiv A) := by
  ext x
  rw [toPermHom_apply]
  simp [unitOfLinearEquiv]

/-- For `n ≠ 2`, every invertible linear map on `n` bits is an even permutation. -/
theorem sign_linearEquiv_eq_one {n : ℕ} (hn : n ≠ 2) (A : V n ≃ₗ[ZMod 2] V n) :
    Perm.sign A.toEquiv = 1 := by
  rw [toEquiv_eq_toPermHom]
  exact sign_toPermHom hn _

theorem sign_linearEquiv_eq_one_of_three_le {n : ℕ} (hn : 3 ≤ n) (A : V n ≃ₗ[ZMod 2] V n) :
    Perm.sign A.toEquiv = 1 :=
  sign_linearEquiv_eq_one (by omega) A

/-- On 2 bits: swapping the two coordinates. -/
def swap2 : V 2 ≃ₗ[ZMod 2] V 2 := LinearEquiv.funCongrLeft (ZMod 2) (ZMod 2) (Equiv.swap 0 1)

theorem swap2_toEquiv : swap2.toEquiv = Equiv.swap (![0, 1] : V 2) ![1, 0] := by
  apply Equiv.ext
  intro x
  funext k
  have hx : x = ![x 0, x 1] := by funext t; fin_cases t <;> rfl
  rw [hx]
  generalize x 0 = a
  generalize x 1 = b
  fin_cases a <;> fin_cases b <;> fin_cases k <;> decide

theorem sign_swap2 : Perm.sign swap2.toEquiv = -1 := by
  rw [swap2_toEquiv]
  exact Perm.sign_swap (by decide)

theorem all_linear_even_iff (n : ℕ) :
    (∀ A : V n ≃ₗ[ZMod 2] V n, Perm.sign A.toEquiv = 1) ↔ n ≠ 2 := by
  constructor
  · rintro h rfl
    have := h swap2
    rw [sign_swap2] at this
    exact absurd this (by decide)
  · intro hn A
    exact sign_linearEquiv_eq_one hn A

/-- A concrete nontrivial transvection on 3 bits is even. -/
theorem sign_transvection_three :
    Perm.sign (toPermHom 3 (tUnit ⟨0, 1, by decide, 1⟩)) = 1 :=
  sign_transvectionPerm (by decide) _

example : Perm.sign (LinearEquiv.refl (ZMod 2) (V 3)).toEquiv = 1 :=
  sign_linearEquiv_eq_one_of_three_le (le_refl 3) _

example : Perm.sign (toPermHom 3 1) = 1 := sign_of_eq_prod (by decide) [] 1 (by simp)

/-! ## Rounds and ciphers -/

/-- One round of a substitution-permutation cipher on `c` chunks of `k` bits. -/
structure Round (c k : ℕ) where
  /-- The round key, XORed onto the block. -/
  key : V (c * k)
  /-- The S-boxes, one per chunk. -/
  S : Fin c → Perm (Fin k → ZMod 2)
  /-- The linear layer. -/
  L : V (c * k) ≃ₗ[ZMod 2] V (c * k)

/-- The permutation of a round: key XOR, then the S-box layer, then the linear layer. -/
def Round.toPerm {c k : ℕ} (r : Round c k) : Perm (V (c * k)) :=
  r.L.toEquiv * sboxLayer r.S * Equiv.addRight r.key

theorem Round.toPerm_apply {c k : ℕ} (r : Round c k) (x : V (c * k)) :
    r.toPerm x = r.L (sboxLayer r.S (x + r.key)) := rfl

/-- The cipher: apply the rounds in list order, head first. -/
def cipher {c k : ℕ} : List (Round c k) → Perm (V (c * k))
  | [] => 1
  | r :: rs => cipher rs * r.toPerm

theorem cipher_nil {c k : ℕ} : cipher ([] : List (Round c k)) = 1 := rfl

theorem cipher_cons_apply {c k : ℕ} (r : Round c k) (rs : List (Round c k)) (x : V (c * k)) :
    cipher (r :: rs) x = cipher rs (r.toPerm x) := rfl

/-- Single round: under `2 ≤ c`, `1 ≤ k`, `3 ≤ c * k`, every round is an even permutation. -/
theorem sign_round {c k : ℕ} (hc : 2 ≤ c) (hk : 1 ≤ k) (hn : 3 ≤ c * k) (r : Round c k) :
    sign r.toPerm = 1 := by
  rw [Round.toPerm, Perm.sign_mul, Perm.sign_mul, sign_linearEquiv_eq_one_of_three_le hn,
    sign_sboxLayer hk hc, sign_addRight (by omega)]
  rfl

theorem round_mem_alternatingGroup {c k : ℕ} (hc : 2 ≤ c) (hk : 1 ≤ k) (hn : 3 ≤ c * k)
    (r : Round c k) : r.toPerm ∈ alternatingGroup (V (c * k)) :=
  mem_alternatingGroup.2 (sign_round hc hk hn r)

/-- Main result: every cipher built from such rounds is an even permutation. -/
theorem sign_cipher {c k : ℕ} (hc : 2 ≤ c) (hk : 1 ≤ k) (hn : 3 ≤ c * k) :
    ∀ rs : List (Round c k), sign (cipher rs) = 1
  | [] => by rw [cipher_nil, map_one]
  | r :: rs => by
    rw [cipher, Perm.sign_mul, sign_cipher hc hk hn rs, sign_round hc hk hn r, one_mul]

theorem cipher_mem_alternatingGroup {c k : ℕ} (hc : 2 ≤ c) (hk : 1 ≤ k) (hn : 3 ≤ c * k)
    (rs : List (Round c k)) : cipher rs ∈ alternatingGroup (V (c * k)) :=
  mem_alternatingGroup.2 (sign_cipher hc hk hn rs)

/-- The group generated by all round permutations lies in the alternating group. -/
theorem closure_rounds_le_alternatingGroup {c k : ℕ} (hc : 2 ≤ c) (hk : 1 ≤ k)
    (hn : 3 ≤ c * k) :
    Subgroup.closure (Set.range (Round.toPerm : Round c k → Perm (V (c * k)))) ≤
      alternatingGroup (V (c * k)) := by
  rw [Subgroup.closure_le]
  rintro _ ⟨r, rfl⟩
  exact round_mem_alternatingGroup hc hk hn r

/-- The hypothesis `3 ≤ c * k` cannot be dropped: for `c = 2`, `k = 1` some round is odd. -/
theorem exists_odd_round_two_one : ∃ r : Round 2 1, sign r.toPerm ≠ 1 := by
  have h := (all_linear_even_iff (2 * 1)).not.2 (by decide)
  obtain ⟨A, hA⟩ := not_forall.1 h
  refine ⟨⟨0, fun _ => 1, A⟩, ?_⟩
  rw [Round.toPerm, Perm.sign_mul, Perm.sign_mul, sign_sboxLayer le_rfl le_rfl,
    sign_addRight (by decide), mul_one, mul_one]
  exact hA

/-! ## Instances of the hypotheses -/

/-- The hypotheses of `sign_round` and `sign_cipher` hold at `c = 2`, `k = 2`. -/
theorem instance_hyps : 2 ≤ 2 ∧ 1 ≤ 2 ∧ 3 ≤ 2 * 2 := by decide

/-- The S-box used in `instance_round`: an odd permutation of 2-bit words. -/
def instSbox : Perm (Fin 2 → ZMod 2) := swap 0 1

theorem instance_sbox_odd : sign instSbox = -1 := sign_swap (by decide)

/-- An explicit round on `V (2 * 2)`: nonzero key, two odd S-boxes, identity linear map. -/
def instance_round : Round 2 2 :=
  ⟨fun _ => 1, fun _ => instSbox, LinearEquiv.refl (ZMod 2) (V (2 * 2))⟩

/-- A two-round cipher on 4 bits with odd S-boxes is even. -/
theorem instance_cipher :
    (instance_round.key ≠ 0) ∧ sign instSbox = -1 ∧
      sign (cipher [instance_round, instance_round]) = 1 :=
  ⟨fun h => by have := congrFun h 0; simp [instance_round] at this, instance_sbox_odd, sign_cipher (by decide) (by decide)
    (by decide) _⟩

/-- Instance of `sign_addRight` with a nonzero key at `n = 2`. -/
theorem instance_addRight : sign (Equiv.addRight (fun _ => 1 : V 2)) = 1 :=
  sign_addRight le_rfl _

end SPNCipherEven

