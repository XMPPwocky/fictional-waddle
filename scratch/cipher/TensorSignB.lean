import Mathlib

/-!
# Signs of copies of a permutation and of parallel S-box layers

PROVED (exactly what the Lean statements below say):

* `TensorSignB.sign_prodCongr`: for finite `α`, `β`, `σ : Perm α`, `τ : Perm β`,
  `sign (σ × τ) = sign σ ^ card β * sign τ ^ card α`, where `σ × τ` is `Equiv.prodCongr σ τ`.
* `TensorSignB.sign_copies`: the permutation `(a, b) ↦ (σ a, b)` of `α × β`
  (`Equiv.prodCongr σ (Equiv.refl β)`) has sign `sign σ ^ card β`.
* `TensorSignB.copies_apply`: that permutation sends `(a, b)` to `(σ a, b)` (by `rfl`).
* `TensorSignB.sign_copies_of_even`: if `card β` is even, that sign is `1`.
* `TensorSignB.copies_mem_alternatingGroup`: same, stated as membership in `alternatingGroup`.
* `TensorSignB.copies_three_odd`: for `α = Fin 2`, `β = Fin 3`, `σ = swap 0 1`, the sign is `-1`
  (so `card β ≥ 2` does not force evenness; parity of `card β` is what matters).
* `TensorSignB.units_pow_even`: `u ^ n = 1` for `u : ℤˣ` and even `n`.
* `TensorSignB.copies_two_even`: two copies of `swap 0 1` on `Fin 2` have sign `1`
  (instance of the hypothesis of `sign_copies_of_even`).
* `TensorSignB.layer_apply`: `layer S x i = S i (x i)` where `layer S = Equiv.piCongrRight S`.
* `TensorSignB.sign_layer_succ`: for `S : Fin (n+1) → Perm α`,
  `sign (layer S) = sign (S 0) ^ (card α ^ n) * sign (layer (fun i => S i.succ)) ^ card α`.
* `TensorSignB.sign_layer`: for every `c` and `S : Fin c → Perm α`,
  `sign (layer S) = ∏ i, sign (S i) ^ (card α ^ (c - 1))`.
* `TensorSignB.sign_layer_of_even`: if `card α` is even and `2 ≤ c`, `sign (layer S) = 1`
  for every `S`; `TensorSignB.layer_mem_alternatingGroup` states the same as membership.
* `TensorSignB.layer_two_even`: two chunks of `Fin 2`, each with `swap 0 1`, sign `1`
  (instance of the hypotheses of `sign_layer_of_even`).
* `TensorSignB.layer_one_odd`: for `c = 1`, `α = Fin 2`, `S 0 = swap 0 1`, the layer has sign `-1`.
* `TensorSignB.sign_layer_bits`: for `α = Fin k → ZMod 2` with `1 ≤ k` and `2 ≤ c`,
  `sign (layer S) = 1` for every `S : Fin c → Perm (Fin k → ZMod 2)`;
  `TensorSignB.layer_bits_mem_alternatingGroup` states the same as membership.
  `TensorSignB.card_bits`: `card (Fin k → ZMod 2) = 2 ^ k`.
  `TensorSignB.sign_layer_bits_instance`: `k = 1`, `c = 2`, transposition S-boxes, sign `1`.
* `TensorSignB.sign_layer_bits_c1_odd`: the hypothesis `2 ≤ c` cannot be dropped in the bits
  case: for `k = 1`, `c = 1` and a transposition as S-box, the layer has sign `-1`.

CITED/INTERPRETED (not proved here):

* Reading: a substitution layer of a block cipher on `c ≥ 2` chunks of `k ≥ 1` bits is an even
  permutation of the state space whatever S-boxes are used; this is the standard observation
  (e.g. in work on the permutation groups generated by round functions of SPN ciphers) that
  such layers lie in the alternating group. The cryptographic reading is not formalised.
-/

namespace TensorSignB

open Equiv Equiv.Perm

section Copies

variable {α β : Type*} [Fintype α] [DecidableEq α] [Fintype β] [DecidableEq β]

/-- Sign of a product permutation `σ × τ` on `α × β`. -/
theorem sign_prodCongr (σ : Perm α) (τ : Perm β) :
    sign (Equiv.prodCongr σ τ : Perm (α × β)) =
      sign σ ^ Fintype.card β * sign τ ^ Fintype.card α := by
  have h : (Equiv.prodCongr σ τ : Perm (α × β)) =
      (Equiv.prodCongrLeft (fun _ : β => σ) : Perm (α × β)) *
        (Equiv.prodCongrRight (fun _ : α => τ) : Perm (α × β)) := by
    ext ⟨a, b⟩ <;> rfl
  rw [h, Perm.sign_mul, sign_prodCongrLeft, sign_prodCongrRight, Finset.prod_const,
    Finset.prod_const, Finset.card_univ, Finset.card_univ]

omit [Fintype α] [DecidableEq α] [Fintype β] [DecidableEq β] in
/-- The copies permutation acts by `σ` on the first coordinate and trivially on the second. -/
theorem copies_apply (σ : Perm α) (a : α) (b : β) :
    (Equiv.prodCongr σ (Equiv.refl β) : Perm (α × β)) (a, b) = (σ a, b) := rfl

/-- `card β` copies of `σ` have sign `sign σ ^ card β`. -/
theorem sign_copies (σ : Perm α) :
    sign (Equiv.prodCongr σ (Equiv.refl β) : Perm (α × β)) = sign σ ^ Fintype.card β := by
  rw [sign_prodCongr]
  have : sign (Equiv.refl β : Perm β) = 1 := Perm.sign_one
  rw [this, one_pow, mul_one]

/-- A unit of `ℤ` raised to an even power is `1`. -/
theorem units_pow_even (u : ℤˣ) {n : ℕ} (hn : Even n) : u ^ n = 1 := by
  obtain ⟨m, rfl⟩ := hn
  rw [← two_mul, pow_mul, Int.units_sq, one_pow]

theorem sign_copies_of_even (σ : Perm α) (h : Even (Fintype.card β)) :
    sign (Equiv.prodCongr σ (Equiv.refl β) : Perm (α × β)) = 1 := by
  rw [sign_copies, units_pow_even _ h]

theorem copies_mem_alternatingGroup (σ : Perm α) (h : Even (Fintype.card β)) :
    (Equiv.prodCongr σ (Equiv.refl β) : Perm (α × β)) ∈ alternatingGroup (α × β) :=
  mem_alternatingGroup.mpr (sign_copies_of_even σ h)

end Copies

/-- Three copies of a transposition on two points: still odd. -/
theorem copies_three_odd :
    sign (Equiv.prodCongr (swap (0 : Fin 2) 1) (Equiv.refl (Fin 3)) : Perm (Fin 2 × Fin 3))
      = -1 := by
  rw [sign_copies, sign_swap (by decide), Fintype.card_fin]
  decide

/-- Instance for the evenness hypothesis of `sign_copies_of_even`. -/
theorem copies_two_even :
    sign (Equiv.prodCongr (swap (0 : Fin 2) 1) (Equiv.refl (Fin 2)) : Perm (Fin 2 × Fin 2))
      = 1 :=
  sign_copies_of_even _ (by rw [Fintype.card_fin]; decide)

section Layer

variable {α : Type*} [Fintype α] [DecidableEq α]

/-- The parallel S-box layer: chunk `i` is permuted by `S i`. -/
abbrev layer {c : ℕ} (S : Fin c → Perm α) : Perm (Fin c → α) := Equiv.piCongrRight S

omit [Fintype α] [DecidableEq α] in
theorem layer_apply {c : ℕ} (S : Fin c → Perm α) (x : Fin c → α) (i : Fin c) :
    layer S x i = S i (x i) := rfl

theorem sign_layer_succ {n : ℕ} (S : Fin (n + 1) → Perm α) :
    sign (layer S) =
      sign (S 0) ^ (Fintype.card α ^ n) * sign (layer (fun i : Fin n => S i.succ)) ^
        Fintype.card α := by
  let e : α × (Fin n → α) ≃ (Fin (n + 1) → α) := Fin.consEquiv (fun _ => α)
  have h : layer S =
      (e.symm.trans (Equiv.prodCongr (S 0) (layer (fun i : Fin n => S i.succ)))).trans e := by
    ext x i
    refine Fin.cases ?_ (fun j => ?_) i
    · simp [e, layer]
    · simp [e, layer, Fin.tail]
  rw [h, sign_symm_trans_trans, sign_prodCongr]
  simp

theorem sign_layer : ∀ {c : ℕ} (S : Fin c → Perm α),
    sign (layer S) = ∏ i, sign (S i) ^ (Fintype.card α ^ (c - 1))
  | 0, S => by
    have : layer S = 1 := Subsingleton.elim _ _
    rw [this, Perm.sign_one]
    simp
  | n + 1, S => by
    rw [sign_layer_succ, sign_layer (fun i : Fin n => S i.succ), Fin.prod_univ_succ]
    congr 1
    rw [← Finset.prod_pow]
    cases n with
    | zero => simp
    | succ m =>
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [← pow_mul, ← pow_succ]
      rfl

theorem sign_layer_of_even {c : ℕ} (S : Fin c → Perm α) (hα : Even (Fintype.card α))
    (hc : 2 ≤ c) : sign (layer S) = 1 := by
  rw [sign_layer]
  refine Finset.prod_eq_one (fun i _ => units_pow_even _ ?_)
  exact (Nat.even_pow' (by omega)).mpr hα

theorem layer_mem_alternatingGroup {c : ℕ} (S : Fin c → Perm α) (hα : Even (Fintype.card α))
    (hc : 2 ≤ c) : layer S ∈ alternatingGroup (Fin c → α) :=
  mem_alternatingGroup.mpr (sign_layer_of_even S hα hc)

end Layer

/-- One chunk with an odd S-box gives an odd layer. -/
theorem layer_one_odd :
    sign (layer (fun _ : Fin 1 => swap (0 : Fin 2) 1)) = -1 := by
  rw [sign_layer, Fin.prod_univ_one, sign_swap (by decide)]
  decide

/-- Instance for the hypotheses of `sign_layer_of_even`: two chunks of `Fin 2`. -/
theorem layer_two_even :
    sign (layer (fun _ : Fin 2 => swap (0 : Fin 2) 1)) = 1 :=
  sign_layer_of_even _ (by rw [Fintype.card_fin]; decide) le_rfl

theorem card_bits (k : ℕ) : Fintype.card (Fin k → ZMod 2) = 2 ^ k := by
  simp

theorem sign_layer_bits {k c : ℕ} (hk : 1 ≤ k) (hc : 2 ≤ c)
    (S : Fin c → Perm (Fin k → ZMod 2)) : sign (layer S) = 1 := by
  refine sign_layer_of_even S ?_ hc
  rw [card_bits]
  exact (Nat.even_pow' (by omega)).mpr even_two

theorem layer_bits_mem_alternatingGroup {k c : ℕ} (hk : 1 ≤ k) (hc : 2 ≤ c)
    (S : Fin c → Perm (Fin k → ZMod 2)) : layer S ∈ alternatingGroup (Fin c → Fin k → ZMod 2) :=
  mem_alternatingGroup.mpr (sign_layer_bits hk hc S)

/-- Instance for the hypotheses of `sign_layer_bits`: `k = 1`, `c = 2`, transposition S-boxes. -/
theorem sign_layer_bits_instance :
    sign (layer (fun _ : Fin 2 =>
      swap (fun _ : Fin 1 => (0 : ZMod 2)) (fun _ => 1))) = 1 :=
  sign_layer_bits le_rfl le_rfl _

/-- Without `2 ≤ c` the bits statement fails: one chunk of one bit with a transposition. -/
theorem sign_layer_bits_c1_odd :
    sign (layer (fun _ : Fin 1 =>
      swap (fun _ : Fin 1 => (0 : ZMod 2)) (fun _ => 1))) = -1 := by
  rw [sign_layer, Fin.prod_univ_one, sign_swap]
  · decide
  · intro h
    have := congrFun h 0
    exact absurd this (by decide)

end TensorSignB

