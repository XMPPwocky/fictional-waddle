/-
# When two parties can agree on a partition

Each party's knowledge is an equivalence relation on states (they cannot tell related states apart).
An event E is self-evident to a party if it never separates two states that party cannot tell apart.
The file characterizes events self-evident to both parties; it does not define iterated "everyone
knows that everyone knows" (whose fixed points coincide with these events; checked by brute force on
small cases, not proved here). The relations need not be equivalences for items 1–2.

PROVED
1. `common_iff_join`: E is self-evident to both A and B exactly when it is self-evident for the
   equivalence relation generated by A and B together (their join). The events both can agree on are
   the unions of cells of the join, the finest partition coarser than both.
2. `connected_no_common`: if the join relates every pair of states, the only events both can agree on
   are ∅ and everything.
3. `example_disagree`: on three states, A = {0,1}{2} and B = {0}{1,2} each know something
   nontrivial (A can tell 2 apart; B can tell 0 apart) but share no nontrivial event.
4. `example_agree`: with A = B = {0,1}{2}, the event {2} is common to both.

CITED
- Aumann, "Agreeing to Disagree" (1976): common knowledge is the meet of the partitions (in the
  coarsening order; the join of the relations here), and common-knowledge posteriors must agree.
-/

import Mathlib

namespace CommonKnowledge

variable {α : Type*}

/-- E never separates two states related by r. -/
def SelfEvident (r : α → α → Prop) (E : Set α) : Prop := ∀ x y, r x y → (x ∈ E ↔ y ∈ E)

/-- The equivalence relation generated by A and B. -/
def Join (A B : α → α → Prop) : α → α → Prop := Relation.EqvGen fun x y => A x y ∨ B x y

theorem common_iff_join (A B : α → α → Prop) (E : Set α) :
    SelfEvident A E ∧ SelfEvident B E ↔ SelfEvident (Join A B) E := by
  constructor
  · rintro ⟨hA, hB⟩ x y hxy
    induction hxy with
    | rel x y h => rcases h with h | h; exact hA x y h; exact hB x y h
    | refl x => exact Iff.rfl
    | symm x y _ ih => exact ih.symm
    | trans x y z _ _ ih1 ih2 => exact ih1.trans ih2
  · intro h
    exact ⟨fun x y hxy => h x y (Relation.EqvGen.rel _ _ (Or.inl hxy)),
      fun x y hxy => h x y (Relation.EqvGen.rel _ _ (Or.inr hxy))⟩

theorem connected_no_common (A B : α → α → Prop) (hconn : ∀ x y, Join A B x y) (E : Set α)
    (hA : SelfEvident A E) (hB : SelfEvident B E) : E = ∅ ∨ E = Set.univ := by
  have h := (common_iff_join A B E).mp ⟨hA, hB⟩
  by_cases hne : E.Nonempty
  · right
    obtain ⟨x, hx⟩ := hne
    exact Set.eq_univ_of_forall fun y => (h x y (hconn x y)).mp hx
  · left
    exact Set.not_nonempty_iff_eq_empty.mp hne

def A3 : Fin 3 → Fin 3 → Prop := fun x y => (x = 2 ↔ y = 2)
def B3 : Fin 3 → Fin 3 → Prop := fun x y => (x = 0 ↔ y = 0)

theorem example_disagree :
    SelfEvident A3 {2} ∧ SelfEvident B3 {0} ∧
      ∀ E : Set (Fin 3), SelfEvident A3 E → SelfEvident B3 E → E = ∅ ∨ E = Set.univ := by
  refine ⟨fun x y h => by simpa [A3] using h, fun x y h => by simpa [B3] using h, ?_⟩
  intro E hA hB
  apply connected_no_common A3 B3 _ E hA hB
  have h01 : Join A3 B3 0 1 := Relation.EqvGen.rel _ _ (Or.inl (by simp [A3]))
  have h12 : Join A3 B3 1 2 := Relation.EqvGen.rel _ _ (Or.inr (by simp [B3]))
  have hall : ∀ x : Fin 3, Join A3 B3 0 x := by
    intro x
    fin_cases x
    · exact Relation.EqvGen.refl _
    · exact h01
    · exact Relation.EqvGen.trans _ _ _ h01 h12
  intro x y
  exact Relation.EqvGen.trans _ _ _ (Relation.EqvGen.symm _ _ (hall x)) (hall y)

theorem example_agree : SelfEvident A3 {2} ∧ SelfEvident A3 {2} ∧ ({2} : Set (Fin 3)) ≠ ∅ ∧
    ({2} : Set (Fin 3)) ≠ Set.univ := by
  refine ⟨fun x y h => by simpa [A3] using h, fun x y h => by simpa [A3] using h, ?_, ?_⟩
  · exact Set.singleton_ne_empty 2
  · intro h
    have : (0 : Fin 3) ∈ ({2} : Set (Fin 3)) := h ▸ Set.mem_univ 0
    simp at this

end CommonKnowledge

#print axioms CommonKnowledge.common_iff_join
#print axioms CommonKnowledge.connected_no_common
#print axioms CommonKnowledge.example_disagree
#print axioms CommonKnowledge.example_agree
