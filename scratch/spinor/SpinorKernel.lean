/-
# The spinor kernel

A two-level state vector ψ ∈ ℂ² determines the matrix ρ = ψψ†. Rotations act on ρ by conjugation,
X ↦ U X U†, and on ψ by U.

PROVED
1. `rho_phase`, `rho_exp_phase`: multiplying ψ by any unit complex number, including e^{iθ},
   leaves ρ unchanged. The phase is invisible in ρ.
2. `act_neg`: U and −U act identically by conjugation.
3. `dot_sq`: (x σx + y σy + z σz)² = (x² + y² + z²) · 1.
4. `U_mul`: if J² = −1 then U(a) = cos a · 1 + sin a · J satisfies U(a) U(b) = U(a + b).
5. `spin_half_rotation_two_pi`, `spin_half_rotation_four_pi`, `spin_half_two_pi_acts_trivially`:
   for a unit axis n, the spin-½ rotation R(θ) = cos(θ/2) · 1 − i sin(θ/2) (n·σ) gives R(2π) = −1
   and R(4π) = 1, while R(2π) acts on every matrix X as the identity.

INTERPRETED (not formalized)
- That R(θ) is the rotation by θ about n in 3-space is the SU(2) → SO(3) double cover, proved
  separately; here only the algebra of the lift is checked.
- The sign R(2π) = −1 is visible only relative to a reference, as in neutron interferometry.
-/

import Mathlib

open Matrix Complex

namespace SpinorKernel

noncomputable section

abbrev M2 := Matrix (Fin 2) (Fin 2) ℂ

/-! ## 1. The phase is invisible in ρ -/

/-- The matrix ψψ† of a state vector. -/
def rho (ψ : Fin 2 → ℂ) : M2 := Matrix.of fun i j => ψ i * star (ψ j)

theorem rho_phase (ψ : Fin 2 → ℂ) (c : ℂ) (hc : Complex.normSq c = 1) :
    rho (c • ψ) = rho ψ := by
  have hcc : c * star c = 1 := by
    rw [Complex.star_def, Complex.mul_conj, hc, Complex.ofReal_one]
  ext i j
  simp only [rho, Matrix.of_apply, Pi.smul_apply, smul_eq_mul, star_mul']
  calc c * ψ i * (star c * star (ψ j)) = (c * star c) * (ψ i * star (ψ j)) := by ring
    _ = ψ i * star (ψ j) := by rw [hcc, one_mul]

theorem rho_exp_phase (ψ : Fin 2 → ℂ) (θ : ℝ) :
    rho (Complex.exp (θ * I) • ψ) = rho ψ :=
  rho_phase ψ _ (by rw [Complex.normSq_eq_norm_sq, Complex.norm_exp_ofReal_mul_I]; norm_num)

/-! ## 2. U and −U act the same way -/

/-- Conjugation action X ↦ U X U†. -/
def act (U X : M2) : M2 := U * X * Uᴴ

theorem act_neg (U X : M2) : act (-U) X = act U X := by
  simp [act, conjTranspose_neg]

/-! ## 3. Pauli matrices -/

def σx : M2 := !![0, 1; 1, 0]
def σy : M2 := !![0, -I; I, 0]
def σz : M2 := !![1, 0; 0, -1]

/-- r·σ for a real vector r = (x, y, z). -/
def dot (x y z : ℝ) : M2 := (x : ℂ) • σx + (y : ℂ) • σy + (z : ℂ) • σz

theorem dot_eq (x y z : ℝ) :
    dot x y z = !![(z : ℂ), x - y * I; x + y * I, -z] := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [dot, σx, σy, σz] <;> ring

theorem dot_sq (x y z : ℝ) :
    dot x y z * dot x y z = ((x ^ 2 + y ^ 2 + z ^ 2 : ℝ) : ℂ) • (1 : M2) := by
  rw [dot_eq, mul_fin_two]
  ext i j
  fin_cases i <;> fin_cases j <;> simp <;> push_cast <;> first
    | ring1
    | linear_combination (-(y : ℂ) ^ 2) * I_sq

/-! ## 4. The one-parameter group generated by J with J² = −1 -/

def U (J : M2) (a : ℝ) : M2 := (Real.cos a : ℂ) • (1 : M2) + (Real.sin a : ℂ) • J

theorem U_mul (J : M2) (hJ : J * J = -1) (a b : ℝ) :
    U J a * U J b = U J (a + b) := by
  simp only [U, add_mul, mul_add, smul_mul_assoc, mul_smul_comm, one_mul,
    mul_one, hJ]
  rw [Real.cos_add, Real.sin_add]
  push_cast
  module

/-! ## 5. Spin-½ rotations: 2π gives −1, 4π gives 1 -/

/-- For a unit axis, J = −i (n·σ) squares to −1. -/
theorem J_sq (x y z : ℝ) (hn : x ^ 2 + y ^ 2 + z ^ 2 = 1) :
    (-(I • dot x y z)) * (-(I • dot x y z)) = -1 := by
  rw [neg_mul_neg, smul_mul_smul_comm, dot_sq, hn, I_mul_I]
  simp

/-- The spin-½ rotation by θ about the unit axis (x, y, z). -/
def R (x y z θ : ℝ) : M2 := U (-(I • dot x y z)) (θ / 2)

theorem R_mul (x y z : ℝ) (hn : x ^ 2 + y ^ 2 + z ^ 2 = 1) (θ φ : ℝ) :
    R x y z θ * R x y z φ = R x y z (θ + φ) := by
  unfold R
  rw [U_mul _ (J_sq x y z hn)]
  congr 1
  ring

theorem spin_half_rotation_two_pi (x y z : ℝ) : R x y z (2 * Real.pi) = -1 := by
  simp [R, U, show 2 * Real.pi / 2 = Real.pi by ring]

theorem spin_half_rotation_four_pi (x y z : ℝ) : R x y z (4 * Real.pi) = 1 := by
  have h : 4 * Real.pi / 2 = 2 * Real.pi := by ring
  simp [R, U, h]

theorem spin_half_two_pi_acts_trivially (x y z : ℝ) (X : M2) :
    act (R x y z (2 * Real.pi)) X = X := by
  rw [spin_half_rotation_two_pi, act_neg]
  simp [act]

end

end SpinorKernel

