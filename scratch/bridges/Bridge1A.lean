import Mathlib

/-!
# Faithful sum-encodings of tic-tac-toe need 10 symbols; with exactly 10 they are the Lo Shu mod 10

The board definitions `lo`, `lines`, `inLine`, `isLine`, `rot` are copied verbatim from
`scratch/sidechannel/LoShu.lean` (namespace `LoShu`); `refl` is the left-right mirror and `D4` is the
8-element set generated by `rot` and `refl`, listed explicitly.

An encoding of the board in an additive commutative group `G` is a pair `(g, t)` with `g : Fin 9 → G`,
`t : G`. It is `Magic` if every line sums to `t`, and `Faithful` if three distinct cells form a line
iff their labels sum to `t`.

PROVED:
* `faithful_injective` (a): for any `AddCommGroup G`, `Faithful g t → Function.Injective g`.
* `magic_form`: for any `AddCommGroup G`, `Magic g t` forces `t = 3 g₄` and
  `g = g₄ + hv (g₀ - g₄) (g₁ - g₄)` (the 2-parameter family of centred magic squares).
* `rat_magic_faithful_iff_injective` (b): over `ℚ`, `Magic g t → (Faithful g t ↔ Function.Injective g)`.
* `no_faithful_of_card_lt_ten` (c): if `G` is a finite `AddCommGroup` with `Fintype.card G < 10`,
  no `(g, t)` is faithful.
* `zmod10_faithful_eq` (d): over `ZMod 10`, the faithful pairs are exactly
  `{(fun x => (lo (σ x) : ZMod 10) + k, 15 + 3 * k) | σ ∈ D4, k : ZMod 10}`, and
  `zmod10_faithful_ncard`: there are exactly 80 of them.
* Supporting: `D4_card` (8 elements), `D4_preserves_lines`.

INTERPRETED (not formalized): "needs 10 symbols" is read as (a) + (c): a faithful encoding is injective,
so needs at least 9 group elements, and 9 is impossible, so a finite group needs at least 10.
-/

namespace Bridge1A

def lo : Fin 9 → ℕ := ![4, 9, 2, 3, 5, 7, 8, 1, 6]

def lines : List (ℕ × ℕ × ℕ) :=
  [(0, 1, 2), (3, 4, 5), (6, 7, 8), (0, 3, 6), (1, 4, 7), (2, 5, 8), (0, 4, 8), (2, 4, 6)]

def inLine (l : ℕ × ℕ × ℕ) (x : ℕ) : Bool := x == l.1 || x == l.2.1 || x == l.2.2

def isLine (a b c : Fin 9) : Bool := lines.any fun l => inLine l a.val && inLine l b.val && inLine l c.val

def rot : Fin 9 → Fin 9 := ![2, 5, 8, 1, 4, 7, 0, 3, 6]

def refl : Fin 9 → Fin 9 := ![2, 1, 0, 5, 4, 3, 8, 7, 6]

/-- The symmetry group of the board: the four rotations and the four reflections. -/
def D4 : Finset (Fin 9 → Fin 9) :=
  {id, rot, rot ∘ rot, rot ∘ rot ∘ rot, refl, refl ∘ rot, refl ∘ rot ∘ rot, refl ∘ rot ∘ rot ∘ rot}

theorem D4_card : D4.card = 8 := by decide +kernel

/-- The elements of `D4`, indexed. -/
def D4f : Fin 8 → (Fin 9 → Fin 9) :=
  ![id, rot, rot ∘ rot, rot ∘ rot ∘ rot, refl, refl ∘ rot, refl ∘ rot ∘ rot, refl ∘ rot ∘ rot ∘ rot]

lemma mem_D4 {σ : Fin 9 → Fin 9} : σ ∈ D4 ↔ ∃ i, D4f i = σ := by
  constructor
  · intro h
    simp only [D4, Finset.mem_insert, Finset.mem_singleton] at h
    rcases h with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    exacts [⟨0, rfl⟩, ⟨1, rfl⟩, ⟨2, rfl⟩, ⟨3, rfl⟩, ⟨4, rfl⟩, ⟨5, rfl⟩, ⟨6, rfl⟩, ⟨7, rfl⟩]
  · rintro ⟨i, rfl⟩
    fin_cases i <;> simp [D4, D4f]

lemma D4f_preserves_lines : ∀ i : Fin 8, ∀ a b c : Fin 9,
    isLine (D4f i a) (D4f i b) (D4f i c) = isLine a b c := by
  decide +kernel

theorem D4_preserves_lines : ∀ σ ∈ D4, ∀ a b c : Fin 9, isLine (σ a) (σ b) (σ c) = isLine a b c := by
  intro σ hσ
  obtain ⟨i, rfl⟩ := mem_D4.1 hσ
  exact D4f_preserves_lines i

section General

variable {G : Type*} [AddCommGroup G]

/-- Every line sums to `t`. -/
def Magic (g : Fin 9 → G) (t : G) : Prop :=
  ∀ a b c : Fin 9, a ≠ b → b ≠ c → a ≠ c → isLine a b c = true → g a + g b + g c = t

/-- Three distinct cells form a line iff their labels sum to `t`. -/
def Faithful (g : Fin 9 → G) (t : G) : Prop :=
  ∀ a b c : Fin 9, a ≠ b → b ≠ c → a ≠ c → (isLine a b c = true ↔ g a + g b + g c = t)

theorem Faithful.magic {g : Fin 9 → G} {t : G} (h : Faithful g t) : Magic g t :=
  fun a b c h1 h2 h3 hl => (h a b c h1 h2 h3).1 hl

lemma escape : ∀ a b : Fin 9, a ≠ b → ∃ x y : Fin 9, a ≠ x ∧ x ≠ y ∧ a ≠ y ∧ b ≠ x ∧ b ≠ y ∧
    isLine a x y = true ∧ isLine b x y = false := by
  decide +kernel

/-- (a) A faithful encoding is injective. -/
theorem faithful_injective {g : Fin 9 → G} {t : G} (h : Faithful g t) : Function.Injective g := by
  intro a b hab
  by_contra hne
  obtain ⟨x, y, h1, h2, h3, h4, h5, hl, hnl⟩ := escape a b hne
  have hs : g a + g x + g y = t := (h a x y h1 h2 h3).1 hl
  have hb : isLine b x y = true := (h b x y h4 h2 h5).2 (by rw [← hab]; exact hs)
  rw [hnl] at hb
  exact Bool.false_ne_true hb

/-- The centred magic square with parameters `α = g₀ - g₄`, `β = g₁ - g₄`. -/
def hv (α β : G) : Fin 9 → G := ![α, β, -α - β, -α - α - β, 0, α + α + β, α + β, -β, -α]

theorem magic_form {g : Fin 9 → G} {t : G} (h : Magic g t) :
    t = g 4 + g 4 + g 4 ∧ ∀ i, g i = g 4 + hv (g 0 - g 4) (g 1 - g 4) i := by
  have E0 := h 0 1 2 (by decide) (by decide) (by decide) (by decide)
  have E1 := h 3 4 5 (by decide) (by decide) (by decide) (by decide)
  have E2 := h 6 7 8 (by decide) (by decide) (by decide) (by decide)
  have E3 := h 0 3 6 (by decide) (by decide) (by decide) (by decide)
  have E4 := h 1 4 7 (by decide) (by decide) (by decide) (by decide)
  have E6 := h 0 4 8 (by decide) (by decide) (by decide) (by decide)
  have E7 := h 2 4 6 (by decide) (by decide) (by decide) (by decide)
  have hC : t = g 4 + g 4 + g 4 := by
    linear_combination (norm := module) -(E4 + E6 + E7 - E0 - E2)
  refine ⟨hC, fun i => ?_⟩
  fin_cases i
  · show g 0 = g 4 + (g 0 - g 4)
    abel
  · show g 1 = g 4 + (g 1 - g 4)
    abel
  · show g 2 = g 4 + (-(g 0 - g 4) - (g 1 - g 4))
    linear_combination (norm := module) E0 + hC
  · show g 3 = g 4 + (-(g 0 - g 4) - (g 0 - g 4) - (g 1 - g 4))
    linear_combination (norm := module) E3 - E7 + E0 + hC
  · show g 4 = g 4 + 0
    abel
  · show g 5 = g 4 + ((g 0 - g 4) + (g 0 - g 4) + (g 1 - g 4))
    linear_combination (norm := module) E1 - E3 + E7 - E0
  · show g 6 = g 4 + ((g 0 - g 4) + (g 1 - g 4))
    linear_combination (norm := module) E7 - E0
  · show g 7 = g 4 + -(g 1 - g 4)
    linear_combination (norm := module) E4 + hC
  · show g 8 = g 4 + -(g 0 - g 4)
    linear_combination (norm := module) E6 + hC

theorem magic_form' {g : Fin 9 → G} {t : G} (h : Magic g t) :
    ∃ p α β : G, t = p + p + p ∧ ∀ i, g i = p + hv α β i :=
  ⟨g 4, g 0 - g 4, g 1 - g 4, magic_form h⟩

theorem faithful_shift (g : Fin 9 → G) (t k : G) :
    Faithful (fun x => g x + k) (t + k + k + k) ↔ Faithful g t := by
  have key : ∀ a b c : Fin 9,
      (g a + k + (g b + k) + (g c + k) = t + k + k + k ↔ g a + g b + g c = t) := by
    intro a b c
    rw [show g a + k + (g b + k) + (g c + k) = (g a + g b + g c) + (k + k + k) by abel,
      show t + k + k + k = t + (k + k + k) by abel, add_left_inj]
  unfold Faithful
  simp only [key]

/-- A non-collinear pair `{i, j}`: the element completing it to sum `t` must be `g i` or `g j`. -/
theorem faithful_noncollinear {g : Fin 9 → G} {t : G} (hf : Faithful g t)
    (hs : Function.Surjective g) (i j : Fin 9) (hij : i ≠ j) (hn : ∀ k, isLine i j k = false) :
    g i + g i + g j = t ∨ g i + g j + g j = t := by
  obtain ⟨k, hk⟩ := hs (t - g i - g j)
  by_cases hki : k = i
  · subst hki
    left
    linear_combination (norm := module) hk
  by_cases hkj : k = j
  · subst hkj
    right
    linear_combination (norm := module) hk
  have hl := (hf i j k hij (Ne.symm hkj) (Ne.symm hki)).2 (by rw [hk]; abel)
  rw [hn k] at hl
  exact absurd hl Bool.false_ne_true

/-- (c) No finite group with fewer than 10 elements carries a faithful encoding. -/
theorem no_faithful_of_card_lt_ten [Fintype G] (hcard : Fintype.card G < 10)
    (g : Fin 9 → G) (t : G) : ¬ Faithful g t := by
  intro hf
  have hinj := faithful_injective hf
  have h9 : Fintype.card G = 9 := by
    have := Fintype.card_le_of_injective g hinj
    simp only [Fintype.card_fin] at this
    omega
  have hsurj : Function.Surjective g :=
    ((Fintype.bijective_iff_injective_and_card g).2 ⟨hinj, by simp [h9]⟩).2
  have hn9 : ∀ x : G, (9 : ℤ) • x = 0 := by
    intro x
    have := card_nsmul_eq_zero (x := x)
    rw [h9] at this
    rw [show (9 : ℤ) = ((9 : ℕ) : ℤ) by norm_num, natCast_zsmul]
    exact this
  have hk1 := faithful_noncollinear hf hsurj 0 5 (by decide) (by decide)
  have hk2 := faithful_noncollinear hf hsurj 1 5 (by decide) (by decide)
  obtain ⟨p, α, β, ht, hg⟩ := magic_form' hf.magic
  have h0 : g 0 = p + α := hg 0
  have h1 : g 1 = p + β := hg 1
  have h5 : g 5 = p + (α + α + β) := hg 5
  have ha := hn9 α
  have hb := hn9 β
  rw [h0, h5, ht] at hk1
  rw [h1, h5, ht] at hk2
  have hab : α = β := by
    rcases hk1 with e1 | e1 <;> rcases hk2 with e2 | e2
    · linear_combination (norm := module) (-4 : ℤ) • e1 + (-5 : ℤ) • e2 + (3 : ℤ) • ha + (2 : ℤ) • hb
    · linear_combination (norm := module) (-7 : ℤ) • e1 + (-4 : ℤ) • e2 + (5 : ℤ) • ha + (2 : ℤ) • hb
    · linear_combination (norm := module) (-2 : ℤ) • e1 + (-8 : ℤ) • e2 + (3 : ℤ) • ha + (3 : ℤ) • hb
    · linear_combination (norm := module) (-8 : ℤ) • e1 + (-1 : ℤ) • e2 + (5 : ℤ) • ha + (2 : ℤ) • hb
  have : g 0 = g 1 := by rw [h0, h1, hab]
  exact absurd (hinj this) (by decide)

end General

section Rat

def uq : Fin 9 → ℤ := ![1, 0, -1, -2, 0, 2, 1, 0, -1]
def vq : Fin 9 → ℤ := ![0, 1, -1, -1, 0, 1, 1, -1, 0]

lemma hv_rat (α β : ℚ) (i : Fin 9) : hv α β i = (uq i : ℚ) * α + (vq i : ℚ) * β := by
  fin_cases i <;> simp [hv, uq, vq] <;> ring

lemma collide : ∀ a b c : Fin 9, a ≠ b → b ≠ c → a ≠ c → isLine a b c = false →
    (uq a + uq b + uq c ≠ 0 ∨ vq a + vq b + vq c ≠ 0) ∧
    ∃ i j : Fin 9, i ≠ j ∧
      (uq a + uq b + uq c) * (vq i - vq j) = (vq a + vq b + vq c) * (uq i - uq j) := by
  decide +kernel

/-- (b) Over `ℚ`, a magic square is a faithful encoding iff its labels are distinct. -/
theorem rat_magic_faithful_iff_injective (g : Fin 9 → ℚ) (t : ℚ) (hm : Magic g t) :
    Faithful g t ↔ Function.Injective g := by
  refine ⟨faithful_injective, fun hinj a b c h1 h2 h3 => ⟨hm a b c h1 h2 h3, fun hs => ?_⟩⟩
  by_contra hl
  have hl' : isLine a b c = false := by simpa using hl
  obtain ⟨hPQ, i, j, hij, hcross⟩ := collide a b c h1 h2 h3 hl'
  obtain ⟨p, α, β, ht, hg⟩ := magic_form' hm
  rw [hg a, hg b, hg c, hv_rat, hv_rat, hv_rat, ht] at hs
  set P := uq a + uq b + uq c with hP
  set Q := vq a + vq b + vq c with hQ
  have key : (P : ℚ) * α + (Q : ℚ) * β = 0 := by
    rw [hP, hQ]
    push_cast
    linear_combination hs
  have hc : (P : ℚ) * ((vq i : ℚ) - vq j) = (Q : ℚ) * ((uq i : ℚ) - uq j) := by
    exact_mod_cast hcross
  have hdiff : ((uq i : ℚ) - uq j) * α + ((vq i : ℚ) - vq j) * β = 0 := by
    rcases hPQ with hP0 | hQ0
    · have hP0' : (P : ℚ) ≠ 0 := by exact_mod_cast hP0
      have hm' : (P : ℚ) * (((uq i : ℚ) - uq j) * α + ((vq i : ℚ) - vq j) * β) = 0 := by
        linear_combination ((uq i : ℚ) - uq j) * key + β * hc
      exact (mul_eq_zero.1 hm').resolve_left hP0'
    · have hQ0' : (Q : ℚ) ≠ 0 := by exact_mod_cast hQ0
      have hm' : (Q : ℚ) * (((uq i : ℚ) - uq j) * α + ((vq i : ℚ) - vq j) * β) = 0 := by
        linear_combination ((vq i : ℚ) - vq j) * key - α * hc
      exact (mul_eq_zero.1 hm').resolve_left hQ0'
  have hgij : g i = g j := by
    rw [hg i, hg j, hv_rat, hv_rat]
    linear_combination hdiff
  exact hij (hinj hgij)

end Rat

section ZMod10

def lo10 : Fin 9 → ZMod 10 := ![4, 9, 2, 3, 5, 7, 8, 1, 6]

lemma lo_cast (i : Fin 9) : (lo i : ZMod 10) = lo10 i := by
  fin_cases i <;> simp [lo, lo10]

lemma zmod10_normal_f : ∀ α β : ZMod 10, Faithful (hv α β) 0 →
    ∃ i : Fin 8, ∀ x, hv α β x = lo10 (D4f i x) - 5 := by
  unfold Faithful
  decide +kernel

lemma zmod10_normal (α β : ZMod 10) (h : Faithful (hv α β) 0) :
    ∃ σ ∈ D4, ∀ x, hv α β x = (lo (σ x) : ZMod 10) - 5 := by
  obtain ⟨i, hi⟩ := zmod10_normal_f α β h
  exact ⟨D4f i, mem_D4.2 ⟨i, rfl⟩, fun x => by rw [hi x, lo_cast]⟩

lemma zmod10_loShu_faithful_f : ∀ i : Fin 8, Faithful (fun x => lo10 (D4f i x)) 15 := by
  unfold Faithful
  decide +kernel

lemma zmod10_loShu_faithful : ∀ σ ∈ D4, Faithful (fun x => (lo (σ x) : ZMod 10)) 15 := by
  intro σ hσ
  obtain ⟨i, rfl⟩ := mem_D4.1 hσ
  simp only [lo_cast]
  exact zmod10_loShu_faithful_f i

lemma D4f_center : ∀ i : Fin 8, D4f i 4 = 4 := by decide +kernel

lemma D4_center : ∀ σ ∈ D4, σ 4 = 4 := by
  intro σ hσ
  obtain ⟨i, rfl⟩ := mem_D4.1 hσ
  exact D4f_center i

lemma D4f_lo_inj : ∀ i j : Fin 8, (∀ x, lo10 (D4f i x) = lo10 (D4f j x)) → D4f i = D4f j := by
  decide +kernel

lemma D4_lo_inj : ∀ σ ∈ D4, ∀ τ ∈ D4,
    (∀ x, (lo (σ x) : ZMod 10) = (lo (τ x) : ZMod 10)) → σ = τ := by
  intro σ hσ τ hτ h
  obtain ⟨i, rfl⟩ := mem_D4.1 hσ
  obtain ⟨j, rfl⟩ := mem_D4.1 hτ
  exact D4f_lo_inj i j fun x => by rw [← lo_cast, ← lo_cast]; exact h x

/-- (d) Over `ZMod 10` the faithful encodings are exactly the shifted, rotated/reflected Lo Shu. -/
theorem zmod10_faithful_eq :
    {q : (Fin 9 → ZMod 10) × ZMod 10 | Faithful q.1 q.2} =
      {q | ∃ σ ∈ D4, ∃ k : ZMod 10, q = (fun x => (lo (σ x) : ZMod 10) + k, 15 + 3 * k)} := by
  ext ⟨g, t⟩
  simp only [Set.mem_ofPred_eq]
  constructor
  · intro hf
    obtain ⟨p, α, β, ht, hg⟩ := magic_form' hf.magic
    have hgf : g = fun x => hv α β x + p := funext fun x => by rw [hg x, add_comm]
    have hf0 : Faithful (hv α β) 0 := by
      rw [← faithful_shift (hv α β) 0 p, ← hgf, zero_add, ← ht]
      exact hf
    obtain ⟨σ, hσ, hx⟩ := zmod10_normal α β hf0
    refine ⟨σ, hσ, p - 5, ?_⟩
    rw [hgf, ht, Prod.mk.injEq]
    refine ⟨funext fun x => ?_, by ring⟩
    simp only [hx x]
    ring
  · rintro ⟨σ, hσ, k, hq⟩
    rw [Prod.mk.injEq] at hq
    obtain ⟨rfl, rfl⟩ := hq
    rw [show (15 : ZMod 10) + 3 * k = 15 + k + k + k by ring, faithful_shift]
    exact zmod10_loShu_faithful σ hσ

theorem zmod10_faithful_ncard :
    Set.ncard {q : (Fin 9 → ZMod 10) × ZMod 10 | Faithful q.1 q.2} = 80 := by
  rw [zmod10_faithful_eq]
  let F : (Fin 9 → Fin 9) × ZMod 10 → (Fin 9 → ZMod 10) × ZMod 10 :=
    fun q => (fun x => (lo (q.1 x) : ZMod 10) + q.2, 15 + 3 * q.2)
  have hset : {q : (Fin 9 → ZMod 10) × ZMod 10 |
      ∃ σ ∈ D4, ∃ k : ZMod 10, q = (fun x => (lo (σ x) : ZMod 10) + k, 15 + 3 * k)} =
      ↑((D4 ×ˢ (Finset.univ : Finset (ZMod 10))).image F) := by
    ext q
    simp only [Set.mem_ofPred_eq, Finset.coe_image, Finset.coe_product, Finset.coe_univ,
      Set.mem_image, Set.mem_prod, Set.mem_univ, and_true, Finset.mem_coe, Prod.exists]
    constructor
    · rintro ⟨σ, hσ, k, rfl⟩
      exact ⟨σ, k, hσ, rfl⟩
    · rintro ⟨σ, k, hσ, rfl⟩
      exact ⟨σ, hσ, k, rfl⟩
  rw [hset, Set.ncard_coe_finset, Finset.card_image_of_injOn, Finset.card_product, D4_card,
    Finset.card_univ, ZMod.card]
  rintro ⟨σ, k⟩ hσ ⟨τ, l⟩ hτ hF
  simp only [Finset.coe_product, Finset.coe_univ, Set.mem_prod, Finset.mem_coe, Set.mem_univ,
    and_true] at hσ hτ
  simp only [F, Prod.mk.injEq] at hF
  obtain ⟨hfun, -⟩ := hF
  have h4 := congrFun hfun 4
  simp only [D4_center σ hσ, D4_center τ hτ, add_right_inj] at h4
  subst h4
  have hst : σ = τ := D4_lo_inj σ hσ τ hτ fun x => by
    simpa using congrFun hfun x
  rw [hst]

end ZMod10

end Bridge1A
