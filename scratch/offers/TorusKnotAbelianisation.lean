import Mathlib

/-!
# Torus knot groups: abelianisation

For natural numbers `a b`, `G a b` is the presented group `⟨x, y | x ^ a * y ^ (-b)⟩`,
i.e. `⟨x, y | x ^ a = y ^ b⟩`, on generators `x = of 0`, `y = of 1` of `FreeGroup (Fin 2)`.

PROVED
* `abelianization_equiv_quot` : for all `a b : ℕ`, `Abelianization (G a b)` is isomorphic to
  `Multiplicative (ℤ × ℤ ⧸ zmultiples (a, -b))` (no positivity needed).
* `quot_equiv_prod` : if `Nat.gcd a b ≠ 0`, then `ℤ × ℤ ⧸ zmultiples (a, -b) ≃+ ℤ × ZMod (gcd a b)`.
* `abelianization_equiv_prod` : for positive `a b`,
  `Abelianization (G a b) ≃* Multiplicative (ℤ × ZMod (Nat.gcd a b))`
  (the underlying equivalence `abelianizationEquivProd` uses only `0 < a`).
* `abelianization_equiv_int` : for positive coprime `a b`,
  `Abelianization (G a b) ≃* Multiplicative ℤ`.
* `toPerm_surjective` : the homomorphism `G 2 3 → Equiv.Perm (Fin 3)` sending `x` to the
  transposition `swap 0 1` and `y` to the 3-cycle `finRotate 3` is surjective.
* The explicit equivalences are the definitions `abelianizationEquivQuot`, `quotEquivProd`,
  `abelianizationEquivProd`, `abelianizationEquivInt`; the theorems above assert their existence.
* `perm_fin_three_not_comm` : `Equiv.Perm (Fin 3)` is not commutative.
* `G23_not_comm` : `G 2 3` is not commutative.

INTERPRETED (not formalized)
* That `G a b` is the fundamental group of the complement of the `(a, b)` torus knot, and the
  conclusion that abelian invariants do not distinguish torus knots from the unknot.
-/

namespace TorusKnotAbelianisation

/-- The relator `x ^ a * y ^ (-b)` in the free group on `x = of 0`, `y = of 1`. -/
def rel (a b : ℕ) : FreeGroup (Fin 2) :=
  FreeGroup.of 0 ^ (a : ℤ) * FreeGroup.of 1 ^ (-(b : ℤ))

/-- The group `⟨x, y | x ^ a = y ^ b⟩`. -/
abbrev G (a b : ℕ) := PresentedGroup ({rel a b} : Set (FreeGroup (Fin 2)))

/-- The subgroup of `ℤ × ℤ` generated by `(a, -b)`. -/
abbrev H (a b : ℕ) : AddSubgroup (ℤ × ℤ) := AddSubgroup.zmultiples ((a : ℤ), -(b : ℤ))

/-- The quotient `ℤ² / ⟨(a, -b)⟩`. -/
abbrev Q (a b : ℕ) := (ℤ × ℤ) ⧸ H a b

section part1

variable (a b : ℕ)

/-- Generator images in `Multiplicative (Q a b)`. -/
def genImg : Fin 2 → Multiplicative (Q a b) :=
  ![Multiplicative.ofAdd (QuotientAddGroup.mk ((1 : ℤ), (0 : ℤ))),
    Multiplicative.ofAdd (QuotientAddGroup.mk ((0 : ℤ), (1 : ℤ)))]

lemma genImg_rel : ∀ r ∈ ({rel a b} : Set (FreeGroup (Fin 2))),
    FreeGroup.lift (genImg a b) r = 1 := by
  intro r hr
  rw [Set.mem_singleton_iff] at hr
  subst hr
  simp only [rel, map_mul, map_zpow, FreeGroup.lift_apply_of]
  apply Multiplicative.toAdd.injective
  simp only [genImg, Matrix.cons_val_zero, Matrix.cons_val_one, toAdd_mul, toAdd_zpow,
    toAdd_ofAdd, toAdd_one]
  rw [← QuotientAddGroup.mk_zsmul, ← QuotientAddGroup.mk_zsmul, ← QuotientAddGroup.mk_add,
    QuotientAddGroup.eq_zero_iff]
  have : (a : ℤ) • ((1 : ℤ), (0 : ℤ)) + (-(b : ℤ)) • ((0 : ℤ), (1 : ℤ)) = ((a : ℤ), -(b : ℤ)) := by
    ext <;> simp
  rw [this]
  exact AddSubgroup.mem_zmultiples _

/-- `Abelianization (G a b) →* Multiplicative (Q a b)`. -/
def fwd : Abelianization (G a b) →* Multiplicative (Q a b) :=
  Abelianization.lift (PresentedGroup.toGroup (genImg_rel a b))

/-- The images of the generators in `Additive (Abelianization (G a b))`. -/
def xA : Additive (Abelianization (G a b)) :=
  Additive.ofMul (Abelianization.of (PresentedGroup.of 0))

/-- The images of the generators in `Additive (Abelianization (G a b))`. -/
def yA : Additive (Abelianization (G a b)) :=
  Additive.ofMul (Abelianization.of (PresentedGroup.of 1))

/-- `ℤ × ℤ →+ Additive (Abelianization (G a b))`, `(m, n) ↦ m x + n y`. -/
def pre : ℤ × ℤ →+ Additive (Abelianization (G a b)) :=
  AddMonoidHom.coprod (zmultiplesHom _ (xA a b)) (zmultiplesHom _ (yA a b))

lemma pre_apply (m n : ℤ) : pre a b (m, n) = m • xA a b + n • yA a b := by
  simp [pre]

lemma H_le_ker : H a b ≤ (pre a b).ker := by
  rw [AddSubgroup.zmultiples_le]
  rw [AddMonoidHom.mem_ker, pre_apply]
  apply Additive.toMul.injective
  simp only [xA, yA, toMul_add, toMul_zsmul, toMul_ofMul, toMul_zero]
  rw [← map_zpow, ← map_zpow, ← map_mul]
  have h : (PresentedGroup.of (0 : Fin 2) : G a b) ^ (a : ℤ) *
      (PresentedGroup.of (1 : Fin 2)) ^ (-(b : ℤ)) = 1 := by
    have := PresentedGroup.one_of_mem (rels := ({rel a b} : Set (FreeGroup (Fin 2))))
      (x := rel a b) rfl
    rw [rel, map_mul, map_zpow, map_zpow] at this
    exact this
  rw [h, map_one]

/-- `Q a b →+ Additive (Abelianization (G a b))`. -/
def bwdAdd : Q a b →+ Additive (Abelianization (G a b)) :=
  QuotientAddGroup.lift (H a b) (pre a b) (H_le_ker a b)

/-- `Multiplicative (Q a b) →* Abelianization (G a b)`. -/
def bwd : Multiplicative (Q a b) →* Abelianization (G a b) :=
  AddMonoidHom.toMultiplicativeLeft (bwdAdd a b)

lemma fwd_of (i : Fin 2) :
    fwd a b (Abelianization.of (PresentedGroup.of i)) = genImg a b i := by
  simp [fwd, PresentedGroup.toGroup.of]

lemma bwd_genImg (i : Fin 2) :
    bwd a b (genImg a b i) = Abelianization.of (PresentedGroup.of i) := by
  fin_cases i
  · simp [bwd, genImg, bwdAdd, pre_apply, xA]
  · simp [bwd, genImg, bwdAdd, pre_apply, yA]

lemma bwd_fwd : (bwd a b).comp (fwd a b) = MonoidHom.id _ := by
  apply Abelianization.hom_ext
  apply PresentedGroup.ext
  intro i
  simp only [MonoidHom.comp_apply, MonoidHom.id_apply]
  rw [fwd_of, bwd_genImg]

lemma fwd_bwd : (fwd a b).comp (bwd a b) = MonoidHom.id _ := by
  ext ⟨m, n⟩
  simp [bwd, bwdAdd, pre_apply, xA, yA, fwd, PresentedGroup.toGroup.of, genImg]
  rw [← QuotientAddGroup.mk_zsmul, ← QuotientAddGroup.mk_zsmul, ← QuotientAddGroup.mk_add]
  congr 1
  ext <;> simp

/-- Part (1a): `Abelianization ⟨x, y | x^a = y^b⟩ ≃* Multiplicative (ℤ² / ⟨(a, -b)⟩)`. -/
def abelianizationEquivQuot : Abelianization (G a b) ≃* Multiplicative (Q a b) :=
  MonoidHom.toMulEquiv (fwd a b) (bwd a b) (bwd_fwd a b) (fwd_bwd a b)

theorem abelianization_equiv_quot :
    Nonempty (Abelianization (G a b) ≃* Multiplicative (Q a b)) :=
  ⟨abelianizationEquivQuot a b⟩

end part1

section part1b

variable (a b : ℕ)

/-- `a / gcd a b` as an integer. -/
def a' : ℤ := ((a / Nat.gcd a b : ℕ) : ℤ)

/-- `b / gcd a b` as an integer. -/
def b' : ℤ := ((b / Nat.gcd a b : ℕ) : ℤ)

/-- First Bezout coefficient. -/
def s : ℤ := Nat.gcdA a b

/-- Second Bezout coefficient. -/
def t : ℤ := Nat.gcdB a b

lemma a_eq : (a : ℤ) = (Nat.gcd a b : ℤ) * a' a b := by
  unfold a'
  exact_mod_cast (Nat.mul_div_cancel' (Nat.gcd_dvd_left a b)).symm

lemma b_eq : (b : ℤ) = (Nat.gcd a b : ℤ) * b' a b := by
  unfold b'
  exact_mod_cast (Nat.mul_div_cancel' (Nat.gcd_dvd_right a b)).symm

lemma bezout (hg : Nat.gcd a b ≠ 0) : a' a b * s a b + b' a b * t a b = 1 := by
  have h := Nat.gcd_eq_gcd_ab a b
  rw [a_eq a b, b_eq a b] at h
  have hg' : ((Nat.gcd a b : ℕ) : ℤ) ≠ 0 := by exact_mod_cast hg
  apply mul_left_cancel₀ hg'
  rw [mul_one]
  unfold s t
  linear_combination -h

/-- `ℤ × ℤ →+ ℤ × ZMod (gcd a b)`, given by the unimodular matrix `[[b', a'], [s, -t]]`. -/
def phi : ℤ × ℤ →+ ℤ × ZMod (Nat.gcd a b) where
  toFun p := (b' a b * p.1 + a' a b * p.2, ((s a b * p.1 - t a b * p.2 : ℤ) : ZMod (Nat.gcd a b)))
  map_zero' := by simp
  map_add' := by
    intro p q
    ext
    · simp only [Prod.fst_add, Prod.snd_add]; ring
    · simp only [Prod.fst_add, Prod.snd_add]; push_cast; ring

lemma H_le_ker_phi (hg : Nat.gcd a b ≠ 0) : H a b ≤ (phi a b).ker := by
  rw [AddSubgroup.zmultiples_le, AddMonoidHom.mem_ker]
  have hb := bezout a b hg
  have e : s a b * (a : ℤ) - t a b * (-(b : ℤ)) = ((Nat.gcd a b : ℕ) : ℤ) := by
    rw [a_eq a b, b_eq a b]; linear_combination ((Nat.gcd a b : ℕ) : ℤ) * hb
  ext
  · show b' a b * (a : ℤ) + a' a b * (-(b : ℤ)) = 0
    rw [a_eq a b, b_eq a b]; ring
  · show (((s a b * (a : ℤ) - t a b * (-(b : ℤ)) : ℤ)) : ZMod (Nat.gcd a b)) = 0
    rw [e]
    simp

/-- The induced map `Q a b →+ ℤ × ZMod (gcd a b)`. -/
def phiQ (hg : Nat.gcd a b ≠ 0) : Q a b →+ ℤ × ZMod (Nat.gcd a b) :=
  QuotientAddGroup.lift (H a b) (phi a b) (H_le_ker_phi a b hg)

lemma lift_ok : (zmultiplesHom (Q a b) (QuotientAddGroup.mk (a' a b, -b' a b) : Q a b))
    ((Nat.gcd a b : ℕ) : ℤ) = 0 := by
  rw [zmultiplesHom_apply, ← QuotientAddGroup.mk_zsmul, QuotientAddGroup.eq_zero_iff]
  have : ((Nat.gcd a b : ℕ) : ℤ) • (a' a b, -b' a b) = ((a : ℤ), -(b : ℤ)) := by
    ext
    · simp [a_eq a b]
    · simp [b_eq a b]
  rw [this]
  exact AddSubgroup.mem_zmultiples _

/-- `ℤ × ZMod (gcd a b) →+ Q a b`, given by the inverse matrix `[[t, a'], [s, -b']]`. -/
def psi : ℤ × ZMod (Nat.gcd a b) →+ Q a b :=
  AddMonoidHom.coprod (zmultiplesHom (Q a b) (QuotientAddGroup.mk (t a b, s a b)))
    (ZMod.lift (Nat.gcd a b) ⟨zmultiplesHom (Q a b) (QuotientAddGroup.mk (a' a b, -b' a b)),
      lift_ok a b⟩)

lemma psi_apply (k z : ℤ) :
    psi a b (k, (z : ZMod (Nat.gcd a b))) =
      QuotientAddGroup.mk (t a b * k + a' a b * z, s a b * k - b' a b * z) := by
  simp only [psi, AddMonoidHom.coprod_apply, ZMod.lift_coe, zmultiplesHom_apply]
  rw [← QuotientAddGroup.mk_zsmul, ← QuotientAddGroup.mk_zsmul, ← QuotientAddGroup.mk_add]
  congr 1
  ext <;> simp <;> ring

lemma psi_phiQ (hg : Nat.gcd a b ≠ 0) : (psi a b).comp (phiQ a b hg) = AddMonoidHom.id _ := by
  have hb := bezout a b hg
  ext ⟨m, n⟩
  · simp only [AddMonoidHom.coe_comp, Function.comp_apply, QuotientAddGroup.coe_mk',
      AddMonoidHom.id_apply, phiQ, QuotientAddGroup.lift_mk]
    show psi a b (_, ((s a b * m - t a b * n : ℤ) : ZMod (Nat.gcd a b))) = _
    rw [psi_apply]
    congr 1
    ext
    · show t a b * (b' a b * m + a' a b * n) + a' a b * (s a b * m - t a b * n) = m
      linear_combination m * hb
    · show s a b * (b' a b * m + a' a b * n) - b' a b * (s a b * m - t a b * n) = n
      linear_combination n * hb

lemma phiQ_psi (hg : Nat.gcd a b ≠ 0) : (phiQ a b hg).comp (psi a b) = AddMonoidHom.id _ := by
  have hb := bezout a b hg
  apply AddMonoidHom.ext
  rintro ⟨k, r⟩
  obtain ⟨z, rfl⟩ := ZMod.intCast_surjective r
  simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddMonoidHom.id_apply]
  rw [psi_apply, phiQ, QuotientAddGroup.lift_mk]
  ext
  · show b' a b * (t a b * k + a' a b * z) + a' a b * (s a b * k - b' a b * z) = k
    linear_combination k * hb
  · show (((s a b * (t a b * k + a' a b * z) - t a b * (s a b * k - b' a b * z) : ℤ)) :
      ZMod (Nat.gcd a b)) = (z : ZMod (Nat.gcd a b))
    congr 1
    linear_combination z * hb

/-- Part (1b): `ℤ² / ⟨(a, -b)⟩ ≃+ ℤ × ZMod (gcd a b)` whenever `gcd a b ≠ 0`. -/
def quotEquivProd (hg : Nat.gcd a b ≠ 0) : Q a b ≃+ ℤ × ZMod (Nat.gcd a b) :=
  AddMonoidHom.toAddEquiv (phiQ a b hg) (psi a b) (psi_phiQ a b hg) (phiQ_psi a b hg)

theorem quot_equiv_prod (hg : Nat.gcd a b ≠ 0) :
    Nonempty (Q a b ≃+ ℤ × ZMod (Nat.gcd a b)) :=
  ⟨quotEquivProd a b hg⟩

/-- `Abelianization (G a b) ≃* Multiplicative (ℤ × ZMod (gcd a b))` for `a > 0`. -/
def abelianizationEquivProd (ha : 0 < a) :
    Abelianization (G a b) ≃* Multiplicative (ℤ × ZMod (Nat.gcd a b)) :=
  (abelianizationEquivQuot a b).trans
    (AddEquiv.toMultiplicative (quotEquivProd a b (Nat.gcd_pos_of_pos_left b ha).ne'))

/-- Part (1), as stated for positive `a b`. -/
theorem abelianization_equiv_prod (ha : 0 < a) (_hb : 0 < b) :
    Nonempty (Abelianization (G a b) ≃* Multiplicative (ℤ × ZMod (Nat.gcd a b))) :=
  ⟨abelianizationEquivProd a b ha⟩

/-- `Abelianization (G a b) ≃* Multiplicative ℤ` when `gcd a b = 1`. -/
def abelianizationEquivInt (h : Nat.gcd a b = 1) :
    Abelianization (G a b) ≃* Multiplicative ℤ :=
  haveI : Subsingleton (ZMod (Nat.gcd a b)) := ZMod.subsingleton_iff.mpr h
  haveI : Unique (ZMod (Nat.gcd a b)) := uniqueOfSubsingleton 0
  (abelianizationEquivQuot a b).trans
    (AddEquiv.toMultiplicative
      ((quotEquivProd a b (by rw [h]; exact one_ne_zero)).trans AddEquiv.prodUnique))

/-- Part (1), coprime case: the abelianisation is infinite cyclic. -/
theorem abelianization_equiv_int (_ha : 0 < a) (_hb : 0 < b) (h : Nat.gcd a b = 1) :
    Nonempty (Abelianization (G a b) ≃* Multiplicative ℤ) :=
  ⟨abelianizationEquivInt a b h⟩

end part1b

section part2

/-- Generator images in `Equiv.Perm (Fin 3)`: a transposition and a 3-cycle. -/
def permImg : Fin 2 → Equiv.Perm (Fin 3) := ![Equiv.swap 0 1, finRotate 3]

lemma permImg_rel : ∀ r ∈ ({rel 2 3} : Set (FreeGroup (Fin 2))),
    FreeGroup.lift permImg r = 1 := by
  intro r hr
  rw [Set.mem_singleton_iff] at hr
  subst hr
  simp only [rel, map_mul, map_zpow, FreeGroup.lift_apply_of, permImg]
  decide

/-- The homomorphism `G 2 3 →* Equiv.Perm (Fin 3)`, `x ↦ (0 1)`, `y ↦ (0 1 2)`. -/
def toPerm : G 2 3 →* Equiv.Perm (Fin 3) := PresentedGroup.toGroup permImg_rel

theorem toPerm_surjective : Function.Surjective toPerm := by
  rw [← MonoidHom.range_eq_top]
  have hc := Equiv.Perm.closure_cycle_adjacent_swap (σ := finRotate 3)
    (isCycle_finRotate (n := 1)) (support_finRotate (n := 1)) 0
  have h1 : finRotate 3 (0 : Fin 3) = 1 := by decide
  rw [h1] at hc
  rw [eq_top_iff, ← hc, Subgroup.closure_le]
  intro p hp
  rcases hp with rfl | rfl
  · exact ⟨PresentedGroup.of 1, by simp [toPerm, PresentedGroup.toGroup.of, permImg]⟩
  · exact ⟨PresentedGroup.of 0, by simp [toPerm, PresentedGroup.toGroup.of, permImg]⟩

theorem perm_fin_three_not_comm : ¬ ∀ p q : Equiv.Perm (Fin 3), p * q = q * p := by
  intro h
  have := h (Equiv.swap 0 1) (finRotate 3)
  revert this
  decide

theorem G23_not_comm : ¬ ∀ p q : G 2 3, p * q = q * p := by
  intro h
  have := congrArg toPerm (h (PresentedGroup.of 0) (PresentedGroup.of 1))
  simp only [map_mul, toPerm, PresentedGroup.toGroup.of, permImg] at this
  revert this
  decide

end part2

end TorusKnotAbelianisation
